# Google Apps Script Web App URL (Deploy → Web app → /exec)
# Paste scripts/google-apps-script/contact-form.js into script.google.com first.
PUBLIC_CONTACT_FORM_URL=https://script.google.com/macros/s/XXXX/exec

# Must match SHARED_SECRET in the Apps Script project
PUBLIC_CONTACT_FORM_TOKEN=choose-a-long-random-string

# Sanity (news content store) — see docs/sanity-vercel-setup.md
SANITY_PROJECT_ID=yourProjectId
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Editor token from sanity.io/manage → API → Tokens (required for /admin writes)
SANITY_TOKEN=

# On-site admin at /admin
ADMIN_PASSWORD=choose-a-password-for-the-customer
ADMIN_SESSION_SECRET=long-random-hex-string

# Called after news create/update/delete so the static site rebuilds
VERCEL_DEPLOY_HOOK_URL=

# Sanity Studio (optional; used only in /sanity)
# SANITY_STUDIO_PROJECT_ID=yourProjectId
# SANITY_STUDIO_DATASET=production
