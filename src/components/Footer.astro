---
import { footerNav, mainNav, site } from "../content/site";
import { toAsciiDigits } from "../utils/text";

const phoneHref = `tel:${toAsciiDigits(site.phone)}`;
const [postalCode, ...addressParts] = site.address.split(" ");
const addressLine = addressParts.join(" ");
const supportLabels = new Set(["お問い合わせ", "お知らせ"]);
const footerMainNav = mainNav.filter((item) => !supportLabels.has(item.label));
const footerSupportNav = [
  ...footerNav,
  ...mainNav
    .filter((item) => supportLabels.has(item.label))
    .map((item) => ({ label: item.label, href: item.href ?? "/" }))
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-company">
      <p class="footer-title">{site.name}</p>
      <p>
        <span class="footer-number">{postalCode}</span><br />
        {addressLine}
      </p>
      <p><a class="footer-number" href={phoneHref}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>共催　一般社団法人全日本養生協会　東京古禅美術館</p>
    </div>

    <nav aria-label="Footer main navigation">
      <ul class="footer-links">
        {footerMainNav.map((item) => {
          const href = item.href ?? item.children?.[0]?.href;
          return href && <li><a href={href}>{item.label}</a></li>;
        })}
      </ul>
    </nav>

    <nav aria-label="Footer support navigation">
      <ul class="footer-links">
        {footerSupportNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
