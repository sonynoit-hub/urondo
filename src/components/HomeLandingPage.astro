---
import page from "../content/home";
import companyPage from "../content/company";
import { toAsciiDigits } from "../utils/text";

const philosophyParagraphs = page.philosophy.paragraphs;
const philosophyStatementLines = page.philosophy.statement.replace("、", "、\n").split("\n");
const treatmentEmphasis = new Set([
  "39年の実績",
  "超実感気功療法",
  "自然治癒力",
  "「気」の流れ",
  "「外気」"
]);
const emphasizeTreatment = (text: string) =>
  text.split(/(39年の実績|超実感気功療法|自然治癒力|「気」の流れ|「外気」)/g);
const classroomEmphasis = new Set([
  "病気にならない心身",
  "東方養生思想",
  "健康習慣",
  "仙道気功養生法",
  "深い呼吸法",
  "気血の巡り"
]);
const emphasizeClassroom = (text: string) =>
  text.split(/(病気にならない心身|東方養生思想|健康習慣|仙道気功養生法|深い呼吸法|気血の巡り)/g);
const companyItems = companyPage.sections?.[0]?.bullets ?? [];
const companyRows = companyItems
  .map((item) => {
    const separatorIndex = item.indexOf("：");

    return {
      label: separatorIndex >= 0 ? item.slice(0, separatorIndex) : "",
      value: separatorIndex >= 0 ? item.slice(separatorIndex + 1) : item
    };
  })
  .reduce<{ label: string; values: string[] }[]>((rows, row) => {
    const previousRow = rows.at(-1);

    if (previousRow && previousRow.label === row.label) {
      previousRow.values.push(row.value);
      return rows;
    }

    rows.push({ label: row.label, values: [row.value] });
    return rows;
  }, []);
const selectCompanyRows = (labels: string[]) =>
  labels.flatMap((label) => {
    const row = companyRows.find((item) => item.label === label);
    return row ? [row] : [];
  });
const companySummary = selectCompanyRows(["商号", "設立", "資本金", "事業内容"]);
const companyDetails = selectCompanyRows([
  "本社所在地",
  "代表取締役兼社長",
  "取締役・総師範"
]);
const companyHistory = companyRows
  .find((row) => row.label === "沿革")
  ?.values.map((value) => {
    const normalizedValue = toAsciiDigits(value);
    const match = normalizedValue.match(/^(平成\d+年\d+月)\s*(.*)$/);

    return {
      date: match?.[1] ?? "",
      detail: match?.[2] ?? normalizedValue
    };
  }) ?? [];
const companyContacts = selectCompanyRows(["TEL", "FAX", "MAIL"]);
const splitCompanyAddress = (value: string) => {
  const normalizedValue = toAsciiDigits(value);
  const match = normalizedValue.match(/^(〒\d{3}-\d{4})\s*(.*)$/);

  return match ? [match[1], match[2]] : [normalizedValue];
};
---

<div class="pdf-home">
  <section class="pdf-panel pdf-cover" aria-labelledby="top-message">
    <div class="pdf-panel-inner pdf-cover-inner">
      <p class="pdf-company-name">株式会社烏龍堂</p>
      <div class="pdf-cover-message">
        <h1 id="top-message">
          {page.heroLines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="pdf-cover-lead">{page.heroIntro}</p>
      </div>
      <div class="pdf-cover-rule" aria-hidden="true">
        <span></span>
        <i></i>
        <span></span>
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-philosophy" aria-labelledby="philosophy-title">
    <div class="pdf-panel-inner pdf-philosophy-inner">
      <header class="pdf-title-plaque">
        <h2 id="philosophy-title">{page.philosophy.title}</h2>
        <div class="pdf-ornament" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
        <p>
          {philosophyStatementLines.map((line) => <span>{line}</span>)}
        </p>
      </header>

      <div class="pdf-philosophy-copy">
        <p>{philosophyParagraphs[0]}</p>
        <div class="pdf-promise-list">
          {page.philosophy.promises.map((promise) => <p>―{promise}</p>)}
        </div>
        {philosophyParagraphs.slice(1).map((paragraph, index) => (
          <p
            class:list={[
              index === 0 && "pdf-philosophy-service",
              index === 1 && "pdf-philosophy-principle",
              index === 2 && "pdf-philosophy-conclusion"
            ]}
          >
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-program" aria-labelledby="program-title">
    <div class="pdf-panel-inner pdf-program-inner">
      <header class="pdf-program-heading">
        <h2 id="program-title">烏龍堂がご提供するプログラム</h2>
        <div class="pdf-ornament" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
      </header>

      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h3>気功療法</h3>
      </div>

      <p class="pdf-program-intro">
        {emphasizeTreatment(page.treatment.intro).map((part) =>
          treatmentEmphasis.has(part) ? <strong>{part}</strong> : part
        )}
      </p>

      <div class="pdf-feature-copy">
        <h3>{page.treatment.featureTitle}</h3>
        {page.treatment.featureParagraphs.map((paragraph) => (
          <p>
            {emphasizeTreatment(paragraph).map((part) =>
              treatmentEmphasis.has(part) ? <strong>{part}</strong> : part
            )}
          </p>
        ))}
      </div>

      <div class="pdf-style-heading">
        <h3>施術スタイル</h3>
        <span></span>
      </div>

      <div class="pdf-treatment-columns">
        {page.treatmentStyles.map((item) => (
          <article class="pdf-treatment-column">
            {item.href ? <a href={item.href}><h4>{item.title}</h4></a> : <h4>{item.title}</h4>}
            {item.body && <p>{item.body}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-classroom" aria-labelledby="classroom-title">
    <div class="pdf-panel-inner pdf-classroom-inner">
      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h2 id="classroom-title">{page.classroom.title}</h2>
      </div>

      <p class="pdf-classroom-intro">
        {emphasizeClassroom(page.classroom.intro).map((part) =>
          classroomEmphasis.has(part) ? <strong>{part}</strong> : part
        )}
      </p>

      <div class="pdf-feature-copy pdf-classroom-feature">
        <h3>{page.classroom.featureTitle}</h3>
        {page.classroom.featureParagraphs.map((paragraph) => (
          <p>
            {emphasizeClassroom(paragraph).map((part) =>
              classroomEmphasis.has(part) ? <strong>{part}</strong> : part
            )}
          </p>
        ))}
      </div>

      <div class="pdf-class-example">
        <h3>通学クラスの一例</h3>
        <ul>
          {page.classroomPractices.map((item) => (
            <li>
              <strong>
                {item.title}
                {item.title !== "発功・気の体感" &&
                  `（${item.title === "調身" ? "身体を整える" : item.title === "調息" ? "呼吸を整える" : "心を整える"}）`}
                ：
              </strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-company" aria-labelledby="company-overview-title">
    <div class="pdf-panel-inner pdf-company-inner">
      <header class="pdf-program-heading pdf-company-heading">
        <h2 id="company-overview-title">{companyPage.heroTitle}</h2>
        <div class="pdf-ornament" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
      </header>

      <dl class="pdf-company-summary">
        {companySummary.map((row) => (
          <div class="pdf-company-summary-item">
            <dt>{row.label}</dt>
            <dd>{row.values.map((value) => <p>{toAsciiDigits(value)}</p>)}</dd>
          </div>
        ))}
      </dl>

      <div class="pdf-company-main">
        <dl class="pdf-company-details">
          {companyDetails.map((row) => (
            <div class="pdf-company-detail">
              <dt>{row.label}</dt>
              <dd>
                {row.values
                  .flatMap((value) =>
                    row.label === "本社所在地"
                      ? splitCompanyAddress(value)
                      : [toAsciiDigits(value)]
                  )
                  .map((value) => <p>{value}</p>)}
              </dd>
            </div>
          ))}
        </dl>

        <section class="pdf-company-timeline" aria-labelledby="company-history-title">
          <h3 id="company-history-title">沿革</h3>
          <ol>
            {companyHistory.map((item) => (
              <li>
                <time>{item.date}</time>
                <p>{item.detail}</p>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <dl class="pdf-company-contact">
        {companyContacts.map((row) => (
          <div class="pdf-company-contact-item">
            <dt>{row.label}</dt>
            <dd>{row.values.map((value) => <p>{toAsciiDigits(value)}</p>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</div>

<style>
  .pdf-home {
    background: #e9e3d7;
    display: grid;
    gap: 0;
    padding: 0;
  }

  :global(body:has(.pdf-home) .site-footer) {
    margin-top: 0;
  }

  .pdf-panel {
    background:
      radial-gradient(circle at 4% 8%, rgba(169, 152, 104, 0.12), transparent 15rem),
      radial-gradient(circle at 96% 88%, rgba(182, 143, 72, 0.08), transparent 13rem),
      #fbfaf6;
    border-bottom: 1px solid rgba(174, 144, 83, 0.5);
    border-top: 1px solid rgba(174, 144, 83, 0.5);
    min-height: min(62.5vw, 700px);
    overflow: hidden;
    position: relative;
  }

  .pdf-panel::before,
  .pdf-panel::after {
    content: "";
    pointer-events: none;
    position: absolute;
    top: 0;
  }

  .pdf-panel::before {
    border-left: 1px solid rgba(174, 144, 83, 0.6);
    bottom: 0;
    left: max(1.2rem, calc((100vw - 1120px) / 2));
  }

  .pdf-panel::after {
    background:
      radial-gradient(ellipse at 100% 80%, transparent 0 48%, rgba(177, 146, 81, 0.09) 49% 50%, transparent 51%),
      radial-gradient(ellipse at 100% 88%, transparent 0 57%, rgba(177, 146, 81, 0.07) 58% 59%, transparent 60%);
    bottom: 0;
    right: 0;
    width: min(18vw, 13rem);
  }

  .pdf-panel-inner {
    margin: 0 auto;
    max-width: 1120px;
    min-height: inherit;
    padding: clamp(2.2rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .pdf-cover {
    background:
      linear-gradient(rgba(250, 247, 239, 0.18), rgba(250, 247, 239, 0.18)),
      url("/images/home/hero-bg-mountains.png") center / cover no-repeat,
      #f5f1e7;
    min-height: calc(100svh - 70px);
  }

  .pdf-cover::after {
    display: none;
  }

  .pdf-cover::before {
    display: none;
  }

  .pdf-cover-inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding-bottom: clamp(2.25rem, 4vw, 3.75rem);
    padding-top: clamp(2.25rem, 4vw, 3.75rem);
    text-align: center;
  }

  .pdf-company-name {
    color: #1d5144;
    font-size: clamp(1rem, 1.55vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.3em;
    margin: 0;
    padding-left: 0.28em;
    position: relative;
  }

  .pdf-company-name::after {
    background: linear-gradient(90deg, transparent, #b48942 22%, #b48942 78%, transparent);
    bottom: -0.75rem;
    content: "";
    height: 1px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: clamp(6rem, 12vw, 9rem);
  }

  .pdf-cover-message {
    align-self: center;
    margin-top: clamp(0.5rem, 1.5vw, 1.25rem);
    transform: translateY(-1.4rem);
    width: 100%;
  }

  .pdf-cover h1 {
    color: #173e34;
    display: grid;
    font-size: clamp(2.25rem, 4.25vw, 4rem);
    font-weight: 500;
    gap: 0.16em;
    letter-spacing: 0.045em;
    line-height: 1.24;
    margin: 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .pdf-cover h1 > span {
    display: block;
  }

  .pdf-cover-lead {
    color: #7c6336;
    font-size: clamp(1rem, 2.1vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.025em;
    line-height: 1.65;
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
  }

  .pdf-cover-rule,
  .pdf-ornament {
    align-items: center;
    display: grid;
    grid-template-columns: minmax(2rem, 1fr) auto minmax(2rem, 1fr);
  }

  .pdf-cover-rule {
    align-self: end;
    width: min(30rem, 64%);
  }

  .pdf-cover-rule span,
  .pdf-ornament span {
    background: linear-gradient(90deg, transparent, #b48942);
    height: 1px;
  }

  .pdf-cover-rule span:last-child,
  .pdf-ornament span:last-child {
    background: linear-gradient(90deg, #b48942, transparent);
  }

  .pdf-cover-rule i,
  .pdf-ornament i {
    border: 1px solid #b48942;
    height: 0.55rem;
    margin: 0 0.8rem;
    transform: rotate(45deg);
    width: 0.55rem;
  }

  .pdf-philosophy {
    background:
      linear-gradient(rgba(252, 249, 241, 0.12), rgba(252, 249, 241, 0.12)),
      url("/images/home/philosophy-bg-harmony.png") center / cover no-repeat,
      #f5f1e7;
    min-height: calc(100svh - 70px);
  }

  .pdf-philosophy::before,
  .pdf-philosophy::after {
    display: none;
  }

  .pdf-philosophy-inner {
    align-content: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    justify-items: center;
    text-align: center;
  }

  .pdf-title-plaque {
    background: transparent;
    padding: 0;
  }

  .pdf-title-plaque h2,
  .pdf-program-heading h2 {
    color: #214e43;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    letter-spacing: 0.14em;
    margin: 0;
  }

  .pdf-title-plaque h2 {
    color: #173e34;
  }

  .pdf-ornament {
    margin: 0.7rem auto;
    width: min(18rem, 72%);
  }

  .pdf-title-plaque > p {
    color: #7c6336;
    font-size: clamp(1.2rem, 2.5vw, 1.85rem);
    line-height: 1.65;
    margin: 0;
  }

  .pdf-title-plaque > p span {
    display: block;
  }

  .pdf-philosophy-copy {
    color: #2d3c36;
    display: grid;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    gap: 0.45rem;
    line-height: 1.8;
    max-width: 50rem;
  }

  .pdf-philosophy-copy p {
    margin: 0;
  }

  .pdf-promise-list {
    display: grid;
    gap: 0.05rem;
  }

  .pdf-philosophy-service {
    margin-top: 0.55rem !important;
  }

  .pdf-philosophy-principle {
    margin-top: 0.85rem !important;
  }

  .pdf-philosophy-conclusion {
    color: #173e34;
    font-weight: 600;
  }

  .pdf-program-inner,
  .pdf-classroom-inner {
    align-content: center;
    display: grid;
    gap: clamp(0.85rem, 1.7vw, 1.35rem);
  }

  .pdf-program {
    background:
      linear-gradient(rgba(252, 249, 241, 0.14), rgba(252, 249, 241, 0.14)),
      url("/images/home/treatment-bg-flowing-qi.png") center / cover no-repeat,
      #f5f1e7;
    min-height: calc(100svh - 70px);
  }

  .pdf-program::before,
  .pdf-program::after {
    display: none;
  }

  .pdf-classroom {
    background:
      linear-gradient(rgba(252, 249, 241, 0.14), rgba(252, 249, 241, 0.14)),
      url("/images/home/treatment-bg-flowing-qi.png") center / cover no-repeat,
      #f5f1e7;
    min-height: calc(100svh - 70px);
  }

  .pdf-classroom::before,
  .pdf-classroom::after {
    display: none;
  }

  .pdf-program-heading {
    background: transparent;
    justify-self: center;
    padding: 0;
    text-align: center;
  }

  .pdf-program-heading h2 {
    color: #173e34;
  }

  .pdf-program-heading .pdf-ornament {
    margin-bottom: 0;
  }

  .pdf-topic-heading {
    align-items: center;
    display: flex;
    gap: 0.7rem;
  }

  .pdf-topic-heading > span {
    border: 2px solid #b58b45;
    border-radius: 50%;
    height: 1.7rem;
    position: relative;
    width: 1.7rem;
  }

  .pdf-topic-heading > span::after {
    border-bottom: 2px solid #b58b45;
    border-radius: 50%;
    content: "";
    height: 0.8rem;
    left: 0.28rem;
    position: absolute;
    top: 0.2rem;
    transform: rotate(25deg);
    width: 0.9rem;
  }

  .pdf-topic-heading h2,
  .pdf-topic-heading h3 {
    color: #173e34;
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    margin: 0;
  }

  .pdf-classroom .pdf-topic-heading h2 {
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    letter-spacing: 0.08em;
  }

  .pdf-program-intro,
  .pdf-classroom-intro,
  .pdf-feature-copy p {
    color: #2d3c36;
    font-size: clamp(0.92rem, 1.35vw, 1.05rem);
    line-height: 1.75;
    margin: 0;
  }

  .pdf-program-intro {
    font-size: clamp(1rem, 1.45vw, 1.1rem);
    line-height: 1.8;
    max-width: 62rem;
  }

  .pdf-classroom-intro {
    font-size: clamp(1rem, 1.45vw, 1.1rem);
    line-height: 1.8;
    max-width: 68rem;
  }

  .pdf-program-intro strong,
  .pdf-program .pdf-feature-copy strong {
    color: #7c6336;
    font-weight: 700;
  }

  .pdf-program .pdf-feature-copy {
    display: grid;
    gap: 0.65rem;
  }

  .pdf-classroom .pdf-feature-copy {
    display: grid;
    gap: 0.65rem;
  }

  .pdf-classroom-intro strong,
  .pdf-classroom-feature strong {
    color: #7c6336;
    font-weight: 700;
  }

  .pdf-feature-copy h3,
  .pdf-style-heading h3,
  .pdf-class-example h3 {
    color: #173e34;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    margin: 0 0 0.25rem;
  }

  .pdf-style-heading {
    align-items: center;
    display: flex;
    gap: 1rem;
  }

  .pdf-style-heading span {
    background: linear-gradient(90deg, rgba(181, 139, 69, 0.7), transparent);
    height: 1px;
    width: 10rem;
  }

  .pdf-treatment-columns {
    display: grid;
    gap: clamp(1rem, 2.4vw, 2rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .pdf-treatment-column {
    border-left: 1px solid rgba(181, 139, 69, 0.35);
    display: grid;
    grid-template-rows: auto 1fr;
    padding-left: clamp(0.75rem, 1.5vw, 1.1rem);
  }

  .pdf-treatment-column:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pdf-treatment-column h4 {
    color: #173e34;
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    margin: 0 0 0.55rem;
    min-height: 1.7em;
  }

  .pdf-treatment-column p {
    color: #2d3c36;
    font-size: clamp(0.83rem, 1.15vw, 0.96rem);
    line-height: 1.65;
    margin: 0;
  }

  .pdf-treatment-column a:hover h4,
  .pdf-treatment-column a:focus-visible h4 {
    color: #a3762d;
  }

  .pdf-classroom-feature {
    margin-top: 0.2rem;
  }

  .pdf-class-example ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .pdf-classroom .pdf-class-example {
    margin-top: 0.65rem;
  }

  .pdf-classroom .pdf-class-example ul {
    gap: 0.55rem;
    margin-top: 0.7rem;
  }

  .pdf-class-example li {
    color: #27302d;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.7;
    padding-left: 1rem;
    position: relative;
  }

  .pdf-classroom .pdf-class-example li {
    display: grid;
    gap: 0.4rem;
    grid-template-columns: 13.5rem minmax(0, 1fr);
  }

  .pdf-class-example li::before {
    color: #a3762d;
    content: "・";
    left: 0;
    position: absolute;
  }

  .pdf-class-example strong {
    color: #173e34;
  }

  .pdf-company {
    background:
      linear-gradient(rgba(252, 249, 241, 0.14), rgba(252, 249, 241, 0.14)),
      url("/images/home/company-bg-foundation.png") center / cover no-repeat,
      #f5f1e7;
    min-height: calc(100svh - 70px);
  }

  .pdf-company::before,
  .pdf-company::after {
    display: none;
  }

  .pdf-company-inner {
    align-content: center;
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pdf-company-heading {
    justify-self: center;
    text-align: center;
  }

  .pdf-company-heading h2 {
    color: #173e34;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    letter-spacing: 0.14em;
    margin: 0;
  }

  .pdf-company-heading .pdf-ornament {
    margin-bottom: 0;
  }

  .pdf-company-summary {
    background: rgba(255, 253, 247, 0.42);
    border-bottom: 1px solid rgba(180, 137, 66, 0.42);
    border-top: 1px solid rgba(180, 137, 66, 0.42);
