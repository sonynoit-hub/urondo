---
import page from "../content/home";

const philosophyParagraphs = page.philosophy.paragraphs;
---

<div class="pdf-home">
  <section class="pdf-panel pdf-cover" aria-labelledby="top-message">
    <div class="pdf-panel-inner pdf-cover-inner">
      <p class="pdf-company-name">株式会社烏龍堂</p>
      <h1 id="top-message">
        {page.heroLines.map((line) => <span>{line}</span>)}
      </h1>
      <p class="pdf-cover-lead">{page.heroIntro}</p>
      <div class="pdf-cover-rule" aria-hidden="true">
        <span></span>
        <i></i>
        <span></span>
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-philosophy" aria-labelledby="philosophy-title">
    <div class="pdf-panel-inner pdf-philosophy-inner">
      <header class="pdf-title-plaque">
        <h2 id="philosophy-title">{page.philosophy.title}</h2>
        <div class="pdf-ornament" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
        <p>{page.philosophy.statement}</p>
      </header>

      <div class="pdf-philosophy-copy">
        <p>{philosophyParagraphs[0]}</p>
        <div class="pdf-promise-list">
          {page.philosophy.promises.map((promise) => <p>―{promise}</p>)}
        </div>
        {philosophyParagraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-program" aria-labelledby="program-title">
    <div class="pdf-panel-inner pdf-program-inner">
      <header class="pdf-program-heading">
        <h2 id="program-title">烏龍堂がご提供するプログラム</h2>
        <div class="pdf-ornament" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
      </header>

      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h3>気功療法</h3>
      </div>

      <p class="pdf-program-intro">{page.treatment.intro}</p>

      <div class="pdf-feature-copy">
        <h3>{page.treatment.featureTitle}</h3>
        {page.treatment.featureParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="pdf-style-heading">
        <h3>施術スタイル</h3>
        <span></span>
      </div>

      <div class="pdf-treatment-columns">
        {page.treatmentStyles.map((item) => (
          <article class="pdf-treatment-column">
            {item.href ? <a href={item.href}><h4>{item.title}</h4></a> : <h4>{item.title}</h4>}
            {item.body && <p>{item.body}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-classroom" aria-labelledby="classroom-title">
    <div class="pdf-panel-inner pdf-classroom-inner">
      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h2 id="classroom-title">{page.classroom.title}</h2>
      </div>

      <p class="pdf-classroom-intro">{page.classroom.intro}</p>

      <div class="pdf-feature-copy pdf-classroom-feature">
        <h3>{page.classroom.featureTitle}</h3>
        {page.classroom.featureParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="pdf-class-example">
        <h3>通学クラスの一例</h3>
        <ul>
          {page.classroomPractices.map((item) => (
            <li>
              <strong>
                {item.title}
                {item.title !== "発功・気の体感" &&
                  `（${item.title === "調身" ? "身体を整える" : item.title === "調息" ? "呼吸を整える" : "心を整える"}）`}
                ：
              </strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</div>

<style>
  .pdf-home {
    background: #e9e3d7;
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    padding: clamp(1rem, 2vw, 1.6rem) 0;
  }

  .pdf-panel {
    background:
      radial-gradient(circle at 4% 8%, rgba(169, 152, 104, 0.12), transparent 15rem),
      radial-gradient(circle at 96% 88%, rgba(182, 143, 72, 0.08), transparent 13rem),
      #fbfaf6;
    border-bottom: 1px solid rgba(174, 144, 83, 0.5);
    border-top: 1px solid rgba(174, 144, 83, 0.5);
    min-height: min(62.5vw, 700px);
    overflow: hidden;
    position: relative;
  }

  .pdf-panel::before,
  .pdf-panel::after {
    content: "";
    pointer-events: none;
    position: absolute;
    top: 0;
  }

  .pdf-panel::before {
    border-left: 1px solid rgba(174, 144, 83, 0.6);
    bottom: 0;
    left: max(1.2rem, calc((100vw - 1120px) / 2));
  }

  .pdf-panel::after {
    background:
      radial-gradient(ellipse at 100% 80%, transparent 0 48%, rgba(177, 146, 81, 0.09) 49% 50%, transparent 51%),
      radial-gradient(ellipse at 100% 88%, transparent 0 57%, rgba(177, 146, 81, 0.07) 58% 59%, transparent 60%);
    bottom: 0;
    right: 0;
    width: min(18vw, 13rem);
  }

  .pdf-panel-inner {
    margin: 0 auto;
    max-width: 1120px;
    min-height: inherit;
    padding: clamp(2.2rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .pdf-cover-inner {
    align-content: center;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .pdf-company-name {
    color: #214e43;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    margin: 0;
  }

  .pdf-cover h1 {
    display: grid;
    font-size: clamp(2.25rem, 4.7vw, 4.4rem);
    font-weight: 500;
    gap: 0.18em;
    letter-spacing: 0.055em;
    line-height: 1.2;
    margin: clamp(2.2rem, 5vw, 4rem) 0 0;
  }

  .pdf-cover h1 span {
    display: block;
  }

  .pdf-cover-lead {
    font-size: clamp(1.15rem, 2.5vw, 2rem);
    line-height: 1.6;
    margin: 1rem 0 0;
  }

  .pdf-cover-rule,
  .pdf-ornament {
    align-items: center;
    display: grid;
    grid-template-columns: minmax(2rem, 1fr) auto minmax(2rem, 1fr);
  }

  .pdf-cover-rule {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    width: min(28rem, 70%);
  }

  .pdf-cover-rule span,
  .pdf-ornament span {
    background: linear-gradient(90deg, transparent, #c4a56d);
    height: 1px;
  }

  .pdf-cover-rule span:last-child,
  .pdf-ornament span:last-child {
    background: linear-gradient(90deg, #c4a56d, transparent);
  }

  .pdf-cover-rule i,
  .pdf-ornament i {
    border: 1px solid #c4a56d;
    height: 0.55rem;
    margin: 0 0.8rem;
    transform: rotate(45deg);
    width: 0.55rem;
  }

  .pdf-philosophy-inner {
    align-content: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    justify-items: center;
    text-align: center;
  }

  .pdf-title-plaque {
    background: rgba(255, 253, 247, 0.9);
    padding: 0.8rem clamp(1rem, 4vw, 3rem);
  }

  .pdf-title-plaque h2,
  .pdf-program-heading h2 {
    color: #214e43;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    letter-spacing: 0.14em;
    margin: 0;
  }

  .pdf-ornament {
    margin: 0.7rem auto;
    width: min(18rem, 72%);
  }

  .pdf-title-plaque > p {
    color: #9a6d24;
    font-size: clamp(1.2rem, 2.5vw, 1.85rem);
    line-height: 1.65;
    margin: 0;
  }

  .pdf-philosophy-copy {
    color: #1f2825;
    display: grid;
    font-size: clamp(0.95rem, 1.45vw, 1.1rem);
    gap: 0.35rem;
    line-height: 1.75;
    max-width: 54rem;
  }

  .pdf-philosophy-copy p {
    margin: 0;
  }

  .pdf-promise-list {
    display: grid;
  }

  .pdf-program-inner,
  .pdf-classroom-inner {
    align-content: center;
    display: grid;
    gap: clamp(0.85rem, 1.7vw, 1.35rem);
  }

  .pdf-program-heading {
    background: rgba(255, 253, 247, 0.9);
    justify-self: center;
    padding: 0.65rem clamp(1rem, 3vw, 2.5rem);
    text-align: center;
  }

  .pdf-program-heading .pdf-ornament {
    margin-bottom: 0;
  }

  .pdf-topic-heading {
    align-items: center;
    display: flex;
    gap: 0.7rem;
  }

  .pdf-topic-heading > span {
    border: 2px solid #b58b45;
    border-radius: 50%;
    height: 1.7rem;
    position: relative;
    width: 1.7rem;
  }

  .pdf-topic-heading > span::after {
    border-bottom: 2px solid #b58b45;
    border-radius: 50%;
    content: "";
    height: 0.8rem;
    left: 0.28rem;
    position: absolute;
    top: 0.2rem;
    transform: rotate(25deg);
    width: 0.9rem;
  }

  .pdf-topic-heading h2,
  .pdf-topic-heading h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    margin: 0;
  }

  .pdf-program-intro,
  .pdf-classroom-intro,
  .pdf-feature-copy p {
    color: #27302d;
    font-size: clamp(0.92rem, 1.35vw, 1.05rem);
    line-height: 1.75;
    margin: 0;
  }

  .pdf-feature-copy h3,
  .pdf-style-heading h3,
  .pdf-class-example h3 {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    margin: 0 0 0.25rem;
  }

  .pdf-style-heading {
    align-items: center;
    display: flex;
    gap: 1rem;
  }

  .pdf-style-heading span {
    background: linear-gradient(90deg, rgba(181, 139, 69, 0.7), transparent);
    height: 1px;
    width: 10rem;
  }

  .pdf-treatment-columns {
    display: grid;
    gap: clamp(1rem, 2.4vw, 2rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .pdf-treatment-column {
    border-left: 1px solid rgba(181, 139, 69, 0.35);
    padding-left: clamp(0.75rem, 1.5vw, 1.1rem);
  }

  .pdf-treatment-column:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pdf-treatment-column h4 {
    color: #214e43;
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    margin: 0 0 0.55rem;
  }

  .pdf-treatment-column p {
    color: #333b38;
    font-size: clamp(0.83rem, 1.15vw, 0.96rem);
    line-height: 1.65;
    margin: 0;
  }

  .pdf-treatment-column a:hover h4,
  .pdf-treatment-column a:focus-visible h4 {
    color: #a3762d;
  }

  .pdf-classroom-feature {
    margin-top: 0.2rem;
  }

  .pdf-class-example ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .pdf-class-example li {
    color: #27302d;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.7;
    padding-left: 1rem;
    position: relative;
  }

  .pdf-class-example li::before {
    color: #a3762d;
    content: "・";
    left: 0;
    position: absolute;
  }

  .pdf-class-example strong {
    color: #1c2623;
  }

  @media (max-width: 800px) {
    .pdf-panel {
      min-height: 0;
    }

    .pdf-panel-inner {
      padding: 2.5rem 1.5rem;
    }

    .pdf-treatment-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pdf-treatment-column:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 520px) {
    .pdf-cover h1 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }

    .pdf-cover-lead {
      font-size: 1.05rem;
    }

    .pdf-title-plaque > p {
      font-size: 1.1rem;
    }

    .pdf-treatment-columns {
      grid-template-columns: 1fr;
    }

    .pdf-treatment-column,
    .pdf-treatment-column:nth-child(3) {
      border-left: 0;
      border-top: 1px solid rgba(181, 139, 69, 0.35);
      padding: 1rem 0 0;
    }

    .pdf-treatment-column:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
