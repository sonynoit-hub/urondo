---
import CompanyOverviewIcon from "./CompanyOverviewIcon.astro";
import page from "../content/home";
import companyPage from "../content/company";

type CompanyIconKey =
  | "building"
  | "calendar"
  | "coins"
  | "pin"
  | "person"
  | "sprout"
  | "history"
  | "phone"
  | "printer"
  | "mail";

const iconByLabel: Record<string, CompanyIconKey> = {
  "商号": "building",
  "設立": "calendar",
  "資本金": "coins",
  "本社所在地": "pin",
  "代表取締役兼社長": "person",
  "取締役・総師範": "person",
  "取締役・主任講師": "person",
  "事業内容": "sprout",
  "沿革": "history",
  "TEL": "phone",
  "FAX": "printer",
  "MAIL": "mail"
};

const philosophyParagraphs = page.philosophy.paragraphs;
const philosophyStatementLines = page.philosophy.statement.replace("、", "、\n").split("\n");
const heroIntroParts = page.heroIntro.split("「超実感気功療法」");
const treatmentEmphasis = new Set([
  "39年の実績",
  "超実感気功療法",
  "自然治癒力",
  "「気」の流れ",
  "「外気」"
]);
const emphasizeTreatment = (text: string) =>
  text.split(/(39年の実績|超実感気功療法|自然治癒力|「気」の流れ|「外気」)/g);
const classroomEmphasis = new Set([
  "病気にならない心身",
  "東方養生思想",
  "健康習慣",
  "仙道気功養生法",
  "深い呼吸法",
  "気血の巡り"
]);
const emphasizeClassroom = (text: string) =>
  text.split(/(病気にならない心身|東方養生思想|健康習慣|仙道気功養生法|深い呼吸法|気血の巡り)/g);
const companyItems = companyPage.sections?.[0]?.bullets ?? [];
const historyDatePattern = /^(平成\d+年\d+月)\s*(.+)$/;
const splitCompanyValue = (label: string, value: string) => {
  if (label !== "沿革") {
    return { date: null, body: value };
  }

  const match = value.match(historyDatePattern);

  return match ? { date: match[1], body: match[2] } : { date: null, body: value };
};

const companyRows = companyItems
  .map((item) => {
    const separatorIndex = item.indexOf("：");
    const label = separatorIndex >= 0 ? item.slice(0, separatorIndex) : "";

    return {
      icon: iconByLabel[label] ?? "building",
      label,
      value: separatorIndex >= 0 ? item.slice(separatorIndex + 1) : item
    };
  })
  .reduce<{ icon: CompanyIconKey; label: string; values: string[] }[]>((rows, row) => {
    const previousRow = rows.at(-1);

    if (previousRow && previousRow.label === row.label) {
      previousRow.values.push(row.value);
      return rows;
    }

    rows.push({
      icon: row.icon,
      label: row.label,
      values: [row.value]
    });
    return rows;
  }, []);
---

<div class="pdf-home">
  <div class="pdf-intro-panels">
    <section class="pdf-panel pdf-cover" aria-labelledby="top-message">
      <div class="pdf-panel-inner pdf-cover-inner">
        <p class="pdf-company-name">株式会社烏龍堂</p>
        <div class="pdf-cover-message">
          <h1 id="top-message">
            {page.heroLines.map((line) => <span>{line}</span>)}
          </h1>
          <p class="pdf-cover-lead">
            {heroIntroParts.length === 2 ? (
              <>
                <span>{heroIntroParts[0]}</span>
                <span>「超実感気功療法」</span>
              </>
            ) : page.heroIntro}
          </p>
        </div>
        <div class="pdf-cover-rule" aria-hidden="true">
          <span></span>
          <i></i>
          <span></span>
        </div>
      </div>
    </section>

    <section class="pdf-panel pdf-philosophy" aria-labelledby="philosophy-title">
      <div class="pdf-panel-inner pdf-philosophy-inner">
        <header class="pdf-title-plaque">
          <h2 id="philosophy-title">{page.philosophy.title}</h2>
          <p>
            {philosophyStatementLines.map((line) => <span>{line}</span>)}
          </p>
        </header>

        <div class="pdf-philosophy-copy">
          <p>{philosophyParagraphs[0]}</p>
          <div class="pdf-promise-list">
            {page.philosophy.promises.map((promise) => <p>―{promise}</p>)}
          </div>
          {philosophyParagraphs.slice(1).map((paragraph, index) => (
            <p
              class:list={[
                index === 0 && "pdf-philosophy-service",
                index === 1 && "pdf-philosophy-principle",
                index === 2 && "pdf-philosophy-conclusion"
              ]}
            >
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </section>
  </div>

  <div class="pdf-programs">
  <section class="pdf-panel pdf-program" aria-labelledby="program-title">
    <div class="pdf-panel-inner pdf-program-inner">
      <header class="pdf-program-heading">
        <h2 id="program-title">株式会社烏龍堂がご提供するプログラム</h2>
      </header>

      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h3>気功療法</h3>
      </div>

      <p class="pdf-program-intro">
        {emphasizeTreatment(page.treatment.intro).map((part) =>
          treatmentEmphasis.has(part) ? <strong>{part}</strong> : part
        )}
      </p>

      <div class="pdf-feature-copy">
        <h3>{page.treatment.featureTitle}</h3>
        {page.treatment.featureParagraphs.map((paragraph) => (
          <p>
            {emphasizeTreatment(paragraph).map((part) =>
              treatmentEmphasis.has(part) ? <strong>{part}</strong> : part
            )}
          </p>
        ))}
      </div>

      <div class="pdf-style-heading">
        <h3>施術スタイル</h3>
        <span></span>
      </div>

      <div class="pdf-treatment-columns">
        {page.treatmentStyles.map((item) => (
          <article class="pdf-treatment-column">
            {item.href ? <a href={item.href}><h4>{item.title}</h4></a> : <h4>{item.title}</h4>}
            {item.body && <p>{item.body}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pdf-panel pdf-classroom" aria-labelledby="classroom-title">
    <div class="pdf-panel-inner pdf-classroom-inner">
      <div class="pdf-topic-heading">
        <span aria-hidden="true"></span>
        <h2 id="classroom-title">{page.classroom.title}</h2>
      </div>

      <p class="pdf-classroom-intro">
        {emphasizeClassroom(page.classroom.intro).map((part) =>
          classroomEmphasis.has(part) ? <strong>{part}</strong> : part
        )}
      </p>

      <div class="pdf-feature-copy pdf-classroom-feature">
        <h3>{page.classroom.featureTitle}</h3>
        {page.classroom.featureParagraphs.map((paragraph) => (
          <p>
            {emphasizeClassroom(paragraph).map((part) =>
              classroomEmphasis.has(part) ? <strong>{part}</strong> : part
            )}
          </p>
        ))}
      </div>

      <div class="pdf-class-example">
        <h3>通学クラスの一例</h3>
        <ul>
          {page.classroomPractices.map((item) => (
            <li>
              <strong>
                {item.title}
                {item.title !== "発功・気の体感" &&
                  `（${item.title === "調身" ? "身体を整える" : item.title === "調息" ? "呼吸を整える" : "心を整える"}）`}
                ：
              </strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  </div>

  <section class="pdf-panel pdf-company" aria-labelledby="company-overview-title">
    <div class="pdf-panel-inner pdf-company-inner">
      <header class="pdf-program-heading pdf-company-heading">
        <h2 id="company-overview-title">{companyPage.heroTitle}</h2>
      </header>

      <div class="company-overview-card">
        {companyRows.map((row) => (
          <div class="company-overview-row">
            <CompanyOverviewIcon icon={row.icon} />
            {row.label && <p class="about-bullet-index">{row.label}</p>}
            <div class="company-overview-values">
              {row.values.map((value) => {
                const entry = splitCompanyValue(row.label, value);

                return (
                  <p class:list={[entry.date && "company-history-entry"]}>
                    {entry.date && <span class="company-history-date">{entry.date}</span>}
                    <span>{entry.body}</span>
                  </p>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

<style>
  .pdf-home {
    background: #e9e3d7;
    display: grid;
    gap: 0;
    padding: 0;
  }

  .pdf-intro-panels {
    isolation: isolate;
    position: relative;
    background:
      linear-gradient(180deg, rgba(90, 74, 38, 0.14) 0%, rgba(255, 255, 255, 0.02) 28%, rgba(255, 255, 255, 0) 100%),
      url("/images/home/hero-bg-mountains-continuous.png") center top / 100% 100% no-repeat,
      #f5f1e7;
    background-blend-mode: multiply, normal, normal;
  }

  .pdf-intro-panels::before,
  .pdf-intro-panels::after {
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .pdf-intro-panels::before {
    background: linear-gradient(180deg, rgba(30, 44, 40, 0.08) 0%, rgba(76, 62, 35, 0.06) 18%, rgba(245, 239, 228, 0.03) 42%, rgba(247, 242, 234, 0.06) 70%, rgba(249, 246, 240, 0.10) 100%);
    z-index: 0;
  }

  .pdf-intro-panels::after {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(252, 249, 242, 0.06) 36%, rgba(250, 246, 239, 0.16) 58%, rgba(249, 246, 240, 0.26) 78%, rgba(249, 246, 240, 0.38) 100%);
    z-index: 0;
  }

  :global(body:has(.pdf-home) .site-footer) {
    margin-top: 0;
  }

  .pdf-panel {
    background:
      radial-gradient(circle at 4% 8%, rgba(169, 152, 104, 0.12), transparent 15rem),
      radial-gradient(circle at 96% 88%, rgba(182, 143, 72, 0.08), transparent 13rem),
      #fbfaf6;
    min-height: min(62.5vw, 700px);
    overflow: hidden;
    position: relative;
  }

  .pdf-panel::before,
  .pdf-panel::after {
    content: "";
    pointer-events: none;
    position: absolute;
    top: 0;
  }

  .pdf-cover,
  .pdf-philosophy {
    background: transparent;
  }

  .pdf-panel::before {
    border-left: 1px solid rgba(174, 144, 83, 0.6);
    bottom: 0;
    left: max(1.2rem, calc((100vw - 1120px) / 2));
  }

  .pdf-panel::after {
    background:
      radial-gradient(ellipse at 100% 80%, transparent 0 48%, rgba(177, 146, 81, 0.09) 49% 50%, transparent 51%),
      radial-gradient(ellipse at 100% 88%, transparent 0 57%, rgba(177, 146, 81, 0.07) 58% 59%, transparent 60%);
    bottom: 0;
    right: 0;
    width: min(18vw, 13rem);
  }

  .pdf-panel-inner {
    margin: 0 auto;
    max-width: 1120px;
    min-height: inherit;
    padding: clamp(2.2rem, 5vw, 4.5rem) clamp(2rem, 5vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .pdf-cover {
    background: transparent;
    min-height: calc(92svh - 70px);
  }

  .pdf-cover::after {
    display: none;
  }

  .pdf-cover::before {
    display: none;
  }

  .pdf-cover-inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(2.25rem, 4vw, 3.75rem);
    text-align: center;
  }

  .pdf-company-name {
    color: #1d5144;
    font-size: clamp(1rem, 1.55vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.3em;
    margin: 0;
    padding-left: 0.28em;
    position: relative;
  }

  .pdf-company-name::after {
    background: linear-gradient(90deg, transparent, #b48942 22%, #b48942 78%, transparent);
    bottom: -0.75rem;
    content: "";
    height: 1px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: clamp(6rem, 12vw, 9rem);
  }

  .pdf-cover-message {
    align-self: center;
    margin-top: clamp(0.5rem, 1.5vw, 1.25rem);
    transform: translateY(-3.75rem);
    width: 100%;
  }

  .pdf-cover h1 {
    color: #173e34;
    display: grid;
    font-size: clamp(2.25rem, 4.25vw, 4rem);
    font-weight: 500;
    gap: 0.16em;
    letter-spacing: 0.045em;
    line-height: 1.24;
    margin: 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .pdf-cover h1 > span {
    display: block;
  }

  .pdf-cover-lead {
    color: #7c6336;
    font-size: clamp(1rem, 2.1vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.025em;
    line-height: 1.65;
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
  }

  .pdf-cover-lead span {
    display: inline;
  }

  .pdf-cover-rule {
    align-items: center;
    align-self: end;
    display: grid;
    grid-template-columns: minmax(2rem, 1fr) auto minmax(2rem, 1fr);
    width: min(30rem, 64%);
  }

  .pdf-news {
    background:
      linear-gradient(rgba(252, 249, 241, 0.32), rgba(252, 249, 241, 0.32)),
      #f5f1e7;
    min-height: 0;
  }

  .pdf-news::before,
  .pdf-news::after {
    display: none;
  }

  .pdf-news-inner {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.2rem);
    padding-top: clamp(1.5rem, 3vw, 2.2rem);
  }

  .pdf-news-header h2 {
    color: #173e34;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: 0.08em;
    margin: 0;
  }

  .pdf-news-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(186, 154, 92, 0.3);
    border-radius: 20px;
    box-shadow: 0 14px 32px rgba(28, 38, 35, 0.06);
    overflow: hidden;
  }

  .pdf-news-list {
    display: grid;
  }

  .pdf-news-row {
    align-items: start;
    display: grid;
    gap: 0.45rem 1rem;
    grid-template-columns: 8rem minmax(0, 1fr);
    padding: 1rem 1.25rem;
  }

  .pdf-news-row + .pdf-news-row {
    border-top: 1px solid rgba(225, 213, 193, 0.92);
  }

  .pdf-news-date {
    color: #8a6a37;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .pdf-news-title {
    color: #173e34;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .pdf-news-foot {
    border-top: 1px solid rgba(186, 154, 92, 0.25);
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem 1.1rem;
  }

  .pdf-news-foot p {
    color: #53615d;
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0;
  }

  .pdf-cover-rule span {
    background: linear-gradient(90deg, transparent, #b48942);
    height: 1px;
  }

  .pdf-cover-rule span:last-child {
    background: linear-gradient(90deg, #b48942, transparent);
  }

  .pdf-cover-rule i {
    border: 1px solid #b48942;
    height: 0.55rem;
    margin: 0 0.8rem;
    transform: rotate(45deg);
    width: 0.55rem;
  }

  .pdf-philosophy {
    background: transparent;
    border-bottom: 0;
    min-height: calc(100svh - 70px);
    margin-top: -1px;
  }

  .pdf-philosophy::before,
  .pdf-philosophy::after {
    display: none;
  }

  .pdf-philosophy-inner {
    align-content: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    justify-items: center;
    text-align: center;
  }

  .pdf-title-plaque {
    background: transparent;
    padding: 0;
  }

  .pdf-title-plaque h2,
  .pdf-program-heading h2 {
    color: #214e43;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    letter-spacing: 0.14em;
    margin: 0;
  }

  .pdf-title-plaque h2 {
    color: #173e34;
  }

  .pdf-title-plaque > p {
    color: #7c6336;
    font-size: clamp(1.2rem, 2.5vw, 1.85rem);
    line-height: 1.65;
    margin: 0.7rem 0 0;
  }

  .pdf-title-plaque > p span {
    display: block;
  }

  .pdf-philosophy-copy {
    color: #2d3c36;
    display: grid;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    gap: 0.45rem;
    line-height: 1.8;
    max-width: 50rem;
  }

  .pdf-philosophy-copy p {
    margin: 0;
  }

  .pdf-promise-list {
    display: grid;
    gap: 0.05rem;
  }

  .pdf-philosophy-service {
    margin-top: 0.55rem !important;
  }

  .pdf-philosophy-principle {
    margin-top: 0.85rem !important;
  }

  .pdf-philosophy-conclusion {
    color: #173e34;
    font-weight: 600;
  }

  @media (min-width: 1180px) {
    .pdf-philosophy-conclusion {
      white-space: nowrap;
      width: max-content;
    }
  }

  .pdf-program-inner,
  .pdf-classroom-inner {
    align-content: center;
    display: grid;
    gap: clamp(0.85rem, 1.7vw, 1.35rem);
  }

  .pdf-programs {
    background:
      linear-gradient(rgba(252, 249, 241, 0.12), rgba(252, 249, 241, 0.12)),
      url("/images/home/programs-bg-continuous.png") center / 100% 100% no-repeat,
      #f5f1e7;
  }

  .pdf-program {
    background: transparent;
    border-bottom: 0;
    border-top: 0;
    min-height: calc(100svh - 70px);
  }

  .pdf-program::before,
  .pdf-program::after {
    display: none;
  }

  .pdf-classroom {
    background: transparent;
    border-top: 0;
    min-height: calc(100svh - 70px);
  }

  .pdf-classroom::before,
  .pdf-classroom::after {
    display: none;
  }

  .pdf-program-heading {
    background: transparent;
    justify-self: center;
    padding: 0;
    text-align: center;
  }

  .pdf-program-heading h2 {
    color: #173e34;
  }

  .pdf-topic-heading {
    align-items: center;
    display: flex;
    gap: 0.7rem;
  }

  .pdf-topic-heading > span {
    border: 2px solid #b58b45;
    border-radius: 50%;
    height: 1.7rem;
    position: relative;
    width: 1.7rem;
  }

  .pdf-topic-heading > span::after {
    border-bottom: 2px solid #b58b45;
    border-radius: 50%;
    content: "";
    height: 0.8rem;
    left: 0.28rem;
    position: absolute;
    top: 0.2rem;
    transform: rotate(25deg);
    width: 0.9rem;
  }

  .pdf-topic-heading h2,
  .pdf-topic-heading h3 {
    color: #173e34;
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    margin: 0;
  }

  .pdf-program-intro,
  .pdf-classroom-intro,
  .pdf-feature-copy p {
    color: #2d3c36;
    font-size: clamp(0.92rem, 1.35vw, 1.05rem);
    line-height: 1.75;
    margin: 0;
  }

  .pdf-program-intro {
    font-size: clamp(1rem, 1.45vw, 1.1rem);
    line-height: 1.8;
    max-width: 62rem;
  }

  .pdf-classroom-intro {
    font-size: clamp(1rem, 1.45vw, 1.1rem);
    line-height: 1.8;
    max-width: 68rem;
  }

  .pdf-program-intro strong,
  .pdf-program .pdf-feature-copy strong {
    color: #7c6336;
    font-weight: 700;
  }

  .pdf-program .pdf-feature-copy {
    display: grid;
    gap: 0.65rem;
  }

  .pdf-classroom .pdf-feature-copy {
    display: grid;
    gap: 0.65rem;
  }

  .pdf-classroom-intro strong,
  .pdf-classroom-feature strong {
    color: #7c6336;
    font-weight: 700;
  }

  .pdf-feature-copy h3,
  .pdf-style-heading h3,
  .pdf-class-example h3 {
    color: #173e34;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    margin: 0 0 0.25rem;
  }

  .pdf-style-heading {
    align-items: center;
    display: flex;
    gap: 1rem;
  }

  .pdf-style-heading span {
    background: linear-gradient(90deg, rgba(181, 139, 69, 0.7), transparent);
    height: 1px;
    width: 10rem;
  }

  .pdf-treatment-columns {
    display: grid;
    gap: clamp(1rem, 2.4vw, 2rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .pdf-treatment-column {
    border-left: 1px solid rgba(181, 139, 69, 0.35);
    display: grid;
    grid-template-rows: auto 1fr;
    padding-left: clamp(0.75rem, 1.5vw, 1.1rem);
  }

  .pdf-treatment-column:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pdf-treatment-column h4 {
    color: #173e34;
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    margin: 0 0 0.55rem;
    min-height: 1.7em;
  }

  .pdf-treatment-column p {
    color: #2d3c36;
    font-size: clamp(0.83rem, 1.15vw, 0.96rem);
    line-height: 1.65;
    margin: 0;
  }

  .pdf-treatment-column a:hover h4,
  .pdf-treatment-column a:focus-visible h4 {
    color: #a3762d;
  }

  .pdf-classroom-feature {
    margin-top: 0.2rem;
  }

  .pdf-class-example ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .pdf-classroom .pdf-class-example {
    margin-top: 0.65rem;
  }

  .pdf-classroom .pdf-class-example ul {
    gap: 0.55rem;
    margin-top: 0.7rem;
