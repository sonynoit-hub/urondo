---
import { newsItems } from "../content/news";
---

<aside class="floating-news" aria-labelledby="floating-news-title" data-floating-news>
  <button
    class="floating-news-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="floating-news-card"
    data-floating-news-trigger
  >
    お知らせ
  </button>

  <div class="floating-news-card" id="floating-news-card" hidden>
    <div class="floating-news-head">
      <h2 id="floating-news-title">お知らせ</h2>
      <button class="floating-news-close" type="button" aria-label="お知らせを閉じる" data-floating-news-close>
        ×
      </button>
    </div>

    <div class="floating-news-list">
      {newsItems.map((item) =>
        item.href ? (
          <a class="floating-news-row" href={item.href}>
            <span class="floating-news-date">{item.date}</span>
            <span class="floating-news-title">{item.title}</span>
          </a>
        ) : (
          <div class="floating-news-row">
            <span class="floating-news-date">{item.date}</span>
            <span class="floating-news-title">{item.title}</span>
          </div>
        )
      )}
    </div>
  </div>
</aside>

<style>
  .floating-news {
    align-items: flex-end;
    bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    position: fixed;
    right: 1.5rem;
    width: auto;
    z-index: 18;
  }

  .floating-news-card {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(186, 154, 92, 0.34);
    border-radius: 20px;
    box-shadow: 0 18px 42px rgba(28, 38, 35, 0.14);
    overflow: hidden;
    pointer-events: auto;
    width: min(25rem, calc(100vw - 2rem));
  }

  .floating-news-trigger {
    background: linear-gradient(135deg, rgba(33, 78, 67, 0.98), rgba(45, 91, 78, 0.96));
    border: 1px solid rgba(186, 154, 92, 0.42);
    border-radius: 999px;
    box-shadow: 0 14px 34px rgba(28, 38, 35, 0.14);
    color: #f8f3ea;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    padding: 0.82rem 1.2rem;
    pointer-events: auto;
  }

  .floating-news[data-open="true"] .floating-news-trigger {
    display: none;
  }

  .floating-news-head {
    align-items: center;
    background: linear-gradient(135deg, rgba(33, 78, 67, 0.98), rgba(45, 91, 78, 0.96));
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.85rem 1rem 0.88rem 1.1rem;
  }

  .floating-news-head h2 {
    color: #f8f3ea;
    font-size: 1rem;
    letter-spacing: 0.08em;
    line-height: 1.35;
    margin: 0;
  }

  .floating-news-close {
    background: transparent;
    border: 0;
    color: rgba(248, 243, 234, 0.9);
    cursor: pointer;
    font-size: 1.4rem;
    line-height: 1;
    padding: 0;
  }

  .floating-news-list {
    display: grid;
  }

  .floating-news-row {
    align-items: start;
    color: inherit;
    display: grid;
    gap: 0.35rem;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    padding: 0.95rem 1rem;
    text-decoration: none;
  }

  .floating-news-row + .floating-news-row {
    border-top: 1px solid rgba(225, 213, 193, 0.92);
  }

  .floating-news-date {
    color: #8a6a37;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .floating-news-title {
    color: #173e34;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .floating-news {
      bottom: 1rem;
      right: 1rem;
    }

    .floating-news-card {
      width: min(23rem, calc(100vw - 2rem));
    }

    .floating-news-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const floatingNews = document.querySelector("[data-floating-news]");
  const floatingNewsClose = document.querySelector("[data-floating-news-close]");
  const floatingNewsTrigger = document.querySelector("[data-floating-news-trigger]");
  const floatingNewsCard = document.getElementById("floating-news-card");

  if (floatingNews && floatingNewsTrigger && floatingNewsCard) {
    floatingNewsTrigger.addEventListener("click", () => {
      const isHidden = floatingNewsCard.hasAttribute("hidden");
      if (isHidden) {
        floatingNewsCard.removeAttribute("hidden");
        floatingNewsTrigger.setAttribute("aria-expanded", "true");
        floatingNews.setAttribute("data-open", "true");
      } else {
        floatingNewsCard.setAttribute("hidden", "");
        floatingNewsTrigger.setAttribute("aria-expanded", "false");
        floatingNews.setAttribute("data-open", "false");
      }
    });
  }

  if (floatingNews && floatingNewsClose && floatingNewsCard && floatingNewsTrigger) {
    floatingNewsClose.addEventListener("click", () => {
      floatingNewsCard.setAttribute("hidden", "");
      floatingNewsTrigger.setAttribute("aria-expanded", "false");
      floatingNews.setAttribute("data-open", "false");
    });
  }
</script>
