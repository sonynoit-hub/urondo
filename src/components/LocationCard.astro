---
import type { LocationItem } from "../content/types";

interface Props {
  items?: LocationItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="content-section">
    <div class="container card-grid">
      {items.map((item) => (
        <article class="card">
          <h2>{item.name}</h2>
          <p>{item.address}</p>
          {item.access && (
            <ul>
              {item.access.map((line) => <li>{line}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>
)}
