---
import type { PriceItem } from "../content/types";

interface Props {
  items?: PriceItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="content-section">
    <div class="container">
      <h2>料金</h2>
      <div class="stack-list">
        {items.map((item) => (
          <div class="row-card">
            <strong>{item.label}</strong>
            <span>{item.value}</span>
            {item.note && <p>{item.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}
