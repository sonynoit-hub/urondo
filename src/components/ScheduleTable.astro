---
import type { ScheduleItem } from "../content/types";

interface Props {
  items?: ScheduleItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="content-section">
    <div class="container">
      <h2>時間・日程</h2>
      <div class="stack-list">
        {items.map((item) => (
          <div class="row-card">
            <strong>{item.label}</strong>
            <span>{item.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
