---
interface PreviewImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  currentPath: string;
  option: 1 | 2 | 3;
}

const { currentPath, option } = Astro.props;

const switcherLinks = [
  { label: "案１", href: "/about" },
  { label: "案２", href: "/about2" },
  { label: "案３", href: "/about3" }
];

const previewOptions: Record<number, PreviewImage> = {
  1: {
    src: "/images/concepts/about-option-1.png",
    alt: "気功とはページ案１のデザインプレビュー画像",
    width: 1536,
    height: 1024
  },
  2: {
    src: "/images/concepts/about-option-2.png",
    alt: "気功とはページ案２のデザインプレビュー画像",
    width: 1536,
    height: 1024
  },
  3: {
    src: "/images/concepts/about-option-3.png",
    alt: "気功とはページ案３のデザインプレビュー画像",
    width: 1536,
    height: 1024
  }
};

const previewImage = previewOptions[option];
---

<section class="preview-switcher">
  <div class="container preview-switcher-row">
    <span>気功とは比較</span>
    <nav aria-label="About concept switcher">
      <ul class="preview-switcher-list">
        {switcherLinks.map((item) => (
          <li>
            <a class={item.href === currentPath ? "is-active" : undefined} href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<section class="preview-gallery" aria-label="気功とはページデザインプレビュー">
  <div class="container preview-gallery-shell">
    <div class="preview-gallery-block">
      <figure class="preview-gallery-figure">
        <img
          src={previewImage.src}
          alt={previewImage.alt}
          width={previewImage.width}
          height={previewImage.height}
          loading="eager"
        />
      </figure>
    </div>
  </div>
</section>
