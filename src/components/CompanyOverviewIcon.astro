---
type CompanyIconKey =
  | "building"
  | "calendar"
  | "coins"
  | "pin"
  | "person"
  | "sprout"
  | "history"
  | "phone"
  | "printer"
  | "mail";

interface Props {
  icon: CompanyIconKey;
}

const { icon } = Astro.props;
---

<span class="company-overview-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {icon === "building" && (
      <>
        <path d="M4.5 20h15" />
        <path d="M6.5 20V7.5h11V20" />
        <path d="M10 20v-4.5h4V20" />
        <path d="M8.75 10.5h.01" />
        <path d="M12 10.5h.01" />
        <path d="M15.25 10.5h.01" />
        <path d="M8.75 13.25h.01" />
        <path d="M12 13.25h.01" />
        <path d="M15.25 13.25h.01" />
      </>
    )}

    {icon === "calendar" && (
      <>
        <rect x="4.5" y="6.5" width="15" height="13" rx="2.5" />
        <path d="M8 4.75v3.5" />
        <path d="M16 4.75v3.5" />
        <path d="M4.5 10h15" />
        <path d="M8 13.25h2.25" />
        <path d="M12 13.25h2.25" />
        <path d="M8 16.25h2.25" />
        <path d="M12 16.25h2.25" />
      </>
    )}

    {icon === "coins" && (
      <>
        <ellipse cx="9" cy="8" rx="4" ry="2" />
        <path d="M5 8v4c0 1.1 1.8 2 4 2s4-.9 4-2V8" />
        <ellipse cx="15.5" cy="12.5" rx="3.5" ry="1.75" />
        <path d="M12 12.5v3c0 .95 1.55 1.75 3.5 1.75s3.5-.8 3.5-1.75v-3" />
      </>
    )}

    {icon === "pin" && (
      <>
        <path d="M12 20s5-4.85 5-9a5 5 0 1 0-10 0c0 4.15 5 9 5 9Z" />
        <circle cx="12" cy="11" r="1.9" />
      </>
    )}

    {icon === "person" && (
      <>
        <circle cx="12" cy="8.2" r="3.1" />
        <path d="M6.5 18.5c1.35-2.45 3.1-3.7 5.5-3.7s4.15 1.25 5.5 3.7" />
      </>
    )}

    {icon === "sprout" && (
      <>
        <path d="M12 18.5v-7" />
        <path d="M12 12c-2.9 0-5.25-2.1-5.75-5 3.5-.2 6.1 1.15 7.35 3.8" />
        <path d="M12 13c.35-3.05 2.7-5.4 5.75-5.65.05 3.2-1.9 5.65-5.75 5.65Z" />
        <path d="M9 18.5h6" />
      </>
    )}

    {icon === "history" && (
      <>
        <path d="M7.25 7.75H4.75v-2.5" />
        <path d="M4.9 9.25a7.2 7.2 0 1 1 1.15 7.5" />
        <path d="M12 8.5v4l2.6 1.6" />
      </>
    )}

    {icon === "phone" && (
      <>
        <path d="M8.2 5.8c.45 1.8 1.25 3.5 2.4 5.05 1.15 1.5 2.55 2.8 4.15 3.85l1.95-1.95c.25-.25.65-.35.98-.22 1.05.38 2.15.58 3.27.58v3.05c0 .52-.43.95-.95.95C10.62 20.1 3.9 13.38 3.9 5.95c0-.52.43-.95.95-.95H7.9c.47 0 .87.33.3.8 0Z" />
      </>
    )}

    {icon === "printer" && (
      <>
        <path d="M7 8V5.5h10V8" />
        <rect x="5" y="9" width="14" height="6.5" rx="1.8" />
        <rect x="7" y="13.5" width="10" height="5" rx="1" />
        <path d="M16 11.75h1.5" />
      </>
    )}

    {icon === "mail" && (
      <>
        <rect x="4.5" y="6.75" width="15" height="10.5" rx="2" />
        <path d="m5.5 8 6.5 5 6.5-5" />
      </>
    )}
  </svg>
</span>
