---
import type { DownloadItem } from "../content/types";

interface Props {
  items?: DownloadItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="content-section">
    <div class="container card-grid">
      {items.map((item) => (
        <article class="card download-card">
          {item.blank ? null : <h2 class="download-card-title">{item.label}</h2>}
          {item.blank ? null : (
            <div class="download-card-footer">
              {item.href ? (
                <a class="button" href={item.href}>ダウンロード</a>
              ) : (
                <button class="button" type="button" disabled>ダウンロード</button>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
)}
