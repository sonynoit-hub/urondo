---
import type { CardItem } from "../content/types";

interface Props {
  items?: CardItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="content-section">
    <div class="container card-grid">
      {items.map((item) => (
        <article class="card">
          <h2>{item.title}</h2>
          {item.body && <p>{item.body}</p>}
          {item.href && <a class="text-link" href={item.href}>詳細を見る</a>}
        </article>
      ))}
    </div>
  </section>
)}
