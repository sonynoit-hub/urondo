---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import page from "../../content/treatments";
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  <section class="content-section treatments-overview-section">
    <div class="container">
      <div class="treatments-overview-grid">
        {page.cards?.map((card) => (
          <article class="treatments-overview-card">
            <div class="treatments-card-heading">
              <h2>{card.title}</h2>
              <span aria-hidden="true">↗</span>
            </div>
            {card.body && <p>{card.body}</p>}
            {card.href && (
              <a class="text-link treatments-card-link" href={card.href}>
                詳細を見る
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
