---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import TreatmentNav from "../../components/TreatmentNav.astro";
import page from "../../content/treatments-special-remote";
import { toFullWidthDigits } from "../../utils/text";

const [introSection, recentSection, precautionsSection] = page.sections ?? [];
const highlightedNotice = "開催案内は会員にはメールと公式ホームページでお知らせします。";
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  {introSection && (
    <section class="content-section">
      <div class="container">
        <div class="special-remote-intro-card">
          {introSection.paragraphs?.map((paragraph, index) => (
            <p
              class:list={[
                index === 0 ? "in-person-lead" : "in-person-text",
                paragraph === highlightedNotice && "special-remote-notice"
              ]}
            >
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </section>
  )}

  {recentSection && (
    <section class="content-section">
      <div class="container">
        <div class="home-section-heading narrow-heading">
          <h2>{recentSection.title}</h2>
        </div>

        <div class="special-remote-event-card">
          {recentSection.bullets?.map((item) => {
            const [month, ...titleParts] = item.split(" ");
            return (
              <div class="special-remote-event-row">
                <p class="about-bullet-index">{month}</p>
                <p>{titleParts.join(" ")}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {precautionsSection && (
    <section class="content-section">
      <div class="container">
        <div class="home-section-heading narrow-heading remote-precaution-heading">
          <h2>{precautionsSection.title}</h2>
        </div>

        <div class="remote-precaution-list">
          {precautionsSection.bullets?.map((bullet, index) => (
            <article class="remote-precaution-item">
              <p class="about-bullet-index">{toFullWidthDigits(index + 1)}</p>
              <p>{bullet}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <TreatmentNav currentHref="/treatments/special-remote" />
</MainLayout>
