---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";

const products = [
  {
    title: "超実感気功療法",
    image: "/images/source-extracted/related-products/book.jpeg",
    alt: "書籍「超実感気功療法」の表紙",
    description: [
      "梁蔭全が自ら創始した「超実感気功療法」",
      "その気功のパワーを知り、体感し、実際に使うための実用書"
    ],
    prices: ["1,430円（税込）"]
  },
  {
    title: "大宇宙気功療法",
    titleSecondLine: "（入門編）DVD",
    image: "/images/source-extracted/related-products/intro-dvd.jpeg",
    alt: "大宇宙気功療法入門編DVD",
    description: ["梁蔭全による実技指導 DVD", "解説編と実技編の2枚組"],
    prices: ["5,000円（税込）"]
  },
  {
    title: "内経図",
    titleSecondLine: "梁蔭全描画カラーコピー版",
    image: "/images/source-extracted/related-products/naikeizu.jpeg",
    alt: "梁蔭全描画の内経図",
    description: [
      "内経図とは、内丹術の修練を補助するための図です。",
      "一見して、山のように見えますが人体のようにも見えます。",
      "複合した図像は大小宇宙の折り重なった「生命」という、天地自然の複合した要素から成り立っている存在を象徴しています。"
    ],
    prices: [
      "A3版（梁蔭全直筆サイン入り） 5,000円（税込）",
      "大判（66cm × 138cm） 25,000円（税込）"
    ]
  },
  {
    title: "梁蔭全秘伝大宇宙",
    titleSecondLine: "気功療法解説 DVD 全7巻",
    image: "/images/source-extracted/related-products/dvd-series.jpeg",
    alt: "梁蔭全秘伝大宇宙気功療法解説DVD全7巻",
    description: [
      "梁蔭全が実技指導する病状毎のなどの秘伝の大宇宙気功療法を収録したDVDです。一つのDVDに2種類の外気療法が収録されています。"
    ],
    prices: ["解説資料付き 35,000円（税込）"],
    details: [
      "肩こり・目",
      "風・熱・高血圧",
      "糖尿病・潰瘍性大腸炎",
      "指を長短変化させる法・気功甘露水を作る法",
      "癌・白血病",
      "鼻炎・花粉症",
      "心臓・遠距離療法"
    ]
  }
];

const talismans = [
  {
    number: "1",
    title: "全ての願いを叶える",
    detail: "運気向上・健康増進",
    image: "/images/source-extracted/related-products/talisman-01.png"
  },
  {
    number: "2",
    title: "金運良好・学業成就",
    detail: "",
    image: "/images/source-extracted/related-products/talisman-02.jpeg"
  },
  {
    number: "3",
    title: "癌治癒・難病回復・病気予防",
    detail: "",
    image: "/images/source-extracted/related-products/talisman-03.jpeg"
  },
  {
    number: "4",
    title: "個人仕事安定・会社景気回復",
    detail: "事業発展",
    image: "/images/source-extracted/related-products/talisman-04.jpeg"
  },
  {
    number: "5",
    title: "家族元気・夫婦円満・良縁・子宝",
    detail: "万病・社会不安・地震被害消除病",
    image: "/images/source-extracted/related-products/talisman-05.jpeg"
  },
  {
    number: "6",
    title: "長期疲労・心身不安消除",
    detail: "認知症予防",
    image: "/images/source-extracted/related-products/talisman-06.jpeg"
  },
  {
    number: "7",
    title: "【呼吸器健康専用符】",
    detail:
      "新型コロナウィルス予防や後遺症改善、インフルエンザなどの呼吸器系の感染予防・改善に効果を見込める特別な秘伝呪符を、梁蔭全先生が魂を込めて特別な念力でお作りします。",
    image: "/images/source-extracted/related-products/talisman-07.jpeg",
    featured: true
  }
];
---

<MainLayout
  title="関連販売物"
  description="梁蔭全の書籍、気功療法DVD、内経図、秘伝呪符のご案内。"
>
  <PageHero
    title="関連販売物"
    subtitle="書籍、気功療法DVD、内経図、秘伝呪符をご案内します。"
    variant="yellow"
  />

  <section class="product-section" id="product-list">
    <div class="container">
      <div class="product-list">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image-wrap">
              <img src={product.image} alt={product.alt} loading="lazy" />
            </div>

            <div class="product-copy">
              <h3>
                {product.title}
                {product.titleSecondLine && (
                  <>
                    <br />
                    <span>{product.titleSecondLine}</span>
                  </>
                )}
              </h3>
              {product.description.map((paragraph) => <p>{paragraph}</p>)}
              {product.details && (
                <ol class="dvd-list">
                  {product.details.map((item) => <li>{item}</li>)}
                </ol>
              )}
              <div class="price-list">
                {product.prices.map((price) => <p>{price}</p>)}
              </div>
            </div>
          </article>
        ))}
      </div>

      <aside class="purchase-banner">
        <div>
          <p class="purchase-label">ご購入について</p>
          <p>購入希望者はメールでお申し込みください。</p>
        </div>
        <a href="mailto:info@urondo.com">info@urondo.com <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="talisman-section">
    <div class="container">
      <div class="talisman-title-row">
        <div>
          <h2>秘伝呪符の販売</h2>
        </div>
        <p class="sale-period"><span>販売期間</span>年末12月〜翌年1月</p>
      </div>

      <div class="talisman-intro">
        <figure>
          <img
            src="/images/source-extracted/related-products/talisman-overview.jpeg"
            alt="梁蔭全入魂直筆の秘伝呪符"
            loading="lazy"
          />
          <figcaption>梁蔭全 入魂直筆</figcaption>
        </figure>

        <div class="talisman-intro-copy">
          <p class="intro-label">呪符とは</p>
          <p>
            子供が転んで泣いている時、「痛いの痛いの飛んでけ」と唱えると子供がすぐに泣きやむという話は、
            一般によく知られている「おまじない」です。何か神秘的な力を作用させることが呪術なのです。
            超自然的な現象に基づく呪術には、自分に霊障が及ぶ魔性的存在と、幸運のパワーを与えてくれる
            善霊的なものがあります。
          </p>
          <p>
            祟り（たたり）とか憑きものとは、魔性的な現象で、神仏の怨霊が災いすることを指します。
            これが呪詛（じゅそ）で、妬みや恨みに思う相手に災難が起きるよう念じ、それから発する生霊が
            相手に取り憑いてしまうものです。自分が知らないうちに、家や身を滅ぼす呪縛や悪霊の祟りは、
            目に見えないだけに恐ろしいものです。原因不明の災難や事故、病気に悩まされるとか、努力して
            いるのに成果が得られないなど、あなたにも思い当たることはありませんか。人の不幸を招く呪い
            や悪念を断ち切り、運命を好転させる守護パワーを授かりたいものです。梁蔭全の「秘伝呪符」は、
            その福運招来の素晴らしいパワーを秘めた驚異の霊符で、宿命運が悪いとお嘆きの方に朗報となる
            でしょう。
          </p>
          <p class="talisman-summary">
            梁蔭全入魂直筆の7種類の皆様の安定・安全をテーマにした秘伝呪符です。
          </p>
          <div class="talisman-price">
            <span>カードタイプ・色紙</span>
            <strong>各 5,000円<small>（税込）</small></strong>
          </div>
        </div>
      </div>

      <div class="talisman-grid">
        {talismans.map((talisman) => (
          <article class:list={["talisman-card", talisman.featured && "is-featured"]}>
            {!talisman.featured && <span class="talisman-number">{talisman.number}</span>}
            <div class="talisman-image">
              <img src={talisman.image} alt={talisman.title} loading="lazy" />
            </div>
            <div class="talisman-copy">
              {talisman.featured && (
                <span class="talisman-number featured-number">{talisman.number}</span>
              )}
              <div class="talisman-heading">
                <h3>
                  {talisman.title}
                  {talisman.titleSecondLine && (
                    <>
                      <br />
                      {talisman.titleSecondLine}
                    </>
                  )}
                </h3>
              </div>
              <p class="talisman-detail">{talisman.detail}</p>
              {talisman.featuredIntro && (
                <p class="featured-intro">{talisman.featuredIntro}</p>
              )}
              {talisman.featured && (
                <p class="featured-note">
                  上部の『天』は、宇宙を表し下部の人間世界を守っています。人間世界は、上から肺の経絡、
                  呼吸器、後天の集合体です。
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <aside class="application-card">
        <p class="application-index">お申し込み</p>
        <div>
          <h2>秘伝呪符をご希望の方へ</h2>
          <p>
            「秘伝呪符申込書」に必要事項を明記のうえ、呪符料・送料とともに現金書留で郵送願います。
          </p>
          <p>
            特別大切な行事の予定がある方や特に運気向上を願う方のために、梁先生が特別な念を込めて呪符を作成いたします。
          </p>
        </div>
      </aside>
    </div>
  </section>
</MainLayout>

<style>
  .products-hero,
  .talisman-section {
    --poster-yellow: #f6df2a;
    --poster-red: #a62c26;
    --poster-ink: #28251f;
  }

  .products-hero {
    background:
      linear-gradient(90deg, rgba(166, 44, 38, 0.08) 1px, transparent 1px),
      linear-gradient(rgba(166, 44, 38, 0.08) 1px, transparent 1px),
      var(--poster-yellow);
    background-size: 32px 32px;
    border-bottom: 1px solid rgba(88, 66, 18, 0.22);
    overflow: hidden;
    padding: clamp(1.8rem, 4vw, 3rem) 0;
    position: relative;
  }

  .products-hero::after {
    background: rgba(255, 250, 205, 0.72);
    border: 1px solid rgba(166, 44, 38, 0.18);
    border-radius: 50%;
    content: "";
    height: 17rem;
    position: absolute;
    right: -4rem;
    top: -8rem;
    width: 17rem;
  }

  .products-hero-inner {
    position: relative;
    z-index: 1;
  }

  .products-hero h1 {
    color: var(--poster-ink);
    font-size: clamp(2.25rem, 4.25vw, 3.8rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.1;
    margin: 0;
  }

  .product-section {
    padding: 1.2rem 0 clamp(2.5rem, 5vw, 4.5rem);
  }

  .talisman-title-row h2 {
    font-size: clamp(2rem, 4vw, 3.6rem);
    letter-spacing: 0.05em;
    line-height: 1.15;
    margin: 0;
  }

  .product-list {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-card {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--border);
    box-shadow: 0 12px 30px rgba(49, 38, 20, 0.06);
    display: grid;
    grid-template-columns: minmax(150px, 0.72fr) minmax(0, 1.28fr);
    min-width: 0;
    overflow: hidden;
  }

  .product-image-wrap {
    align-items: center;
    background:
      linear-gradient(135deg, rgba(246, 223, 42, 0.94), rgba(250, 241, 160, 0.96));
    display: flex;
    justify-content: center;
    min-height: 100%;
    overflow: hidden;
    padding: 2rem 1.35rem;
    position: relative;
  }

  .product-image-wrap::after {
    border: 1px solid rgba(97, 70, 12, 0.24);
    content: "";
    inset: 0.8rem;
    pointer-events: none;
    position: absolute;
  }

  .product-image-wrap img {
    filter: drop-shadow(0 17px 18px rgba(56, 39, 8, 0.22));
    max-height: 255px;
    object-fit: contain;
    position: relative;
    width: auto;
    z-index: 1;
  }

  .product-copy {
    align-self: center;
    padding: clamp(1.3rem, 2.7vw, 2rem);
  }

  .product-copy h3 {
    color: #2a2b27;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    letter-spacing: 0.03em;
    line-height: 1.45;
    margin: 0 0 0.9rem;
    white-space: nowrap;
  }

  .product-copy > p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
    margin: 0.3rem 0;
  }

  .price-list {
    border-left: 3px solid #a62c26;
    margin-top: 1rem;
    padding-left: 0.8rem;
  }

  .price-list p {
    color: #a62c26;
    font-size: clamp(0.96rem, 1.5vw, 1.12rem);
    font-weight: 700;
    line-height: 1.5;
    margin: 0.2rem 0;
  }

  .dvd-list {
    display: grid;
    gap: 0.35rem;
    grid-template-columns: 1fr;
    list-style-position: inside;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .dvd-list li {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .purchase-banner {
    align-items: center;
    background: #263e38;
    color: #fff;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .purchase-banner p {
    line-height: 1.65;
    margin: 0;
  }

  .purchase-label {
    color: #f6df2a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: 0.25rem !important;
  }

  .purchase-banner a {
    border: 1px solid rgba(255, 255, 255, 0.55);
    flex: 0 0 auto;
    font-family: Georgia, "Times New Roman", serif;
    padding: 0.85rem 1rem;
  }

  .talisman-section {
    background:
      radial-gradient(circle at 12% 8%, rgba(255, 255, 255, 0.58), transparent 20rem),
      var(--poster-yellow);
    border-top: 1px solid rgba(88, 66, 18, 0.22);
    color: var(--poster-ink);
    padding: clamp(4rem, 8vw, 7.5rem) 0;
  }

  .talisman-title-row {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .sale-period {
    align-items: center;
    border-bottom: 1px solid rgba(74, 57, 15, 0.5);
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0 0 0.55rem;
  }

  .sale-period span {
    color: var(--poster-red);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .talisman-intro {
    background: rgba(255, 253, 223, 0.9);
    border: 1px solid rgba(88, 66, 18, 0.28);
    display: grid;
    grid-template-columns: minmax(240px, 0.68fr) minmax(0, 1.32fr);
  }

  .talisman-intro figure {
    border-right: 1px solid rgba(88, 66, 18, 0.22);
    margin: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }

  .talisman-intro figure img {
    box-shadow: 0 20px 35px rgba(70, 48, 6, 0.2);
    margin: 0 auto;
    max-height: 500px;
    object-fit: contain;
    width: auto;
  }

  .talisman-intro figcaption {
    color: #7e321f;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    margin-top: 1rem;
    text-align: center;
  }

  .talisman-intro-copy {
    align-self: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .intro-label {
    color: var(--poster-red);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 0.7rem;
  }

  .talisman-intro-copy > p:not(.intro-label) {
    color: #514923;
    line-height: 1.95;
    margin: 0.8rem 0;
  }

  .talisman-price {
    align-items: center;
    border-top: 1px solid rgba(88, 66, 18, 0.25);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1.75rem;
    padding-top: 1.2rem;
  }

  .talisman-price span {
    color: #6c633d;
    font-size: 0.9rem;
  }

  .talisman-price strong {
    color: var(--poster-red);
    font-size: 1.35rem;
  }

  .talisman-price small {
    font-size: 0.75rem;
  }

  .talisman-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2.5rem;
  }

  .talisman-card {
    align-items: center;
    background: rgba(255, 253, 223, 0.86);
    border: 1px solid rgba(88, 66, 18, 0.24);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 88px minmax(0, 1fr);
    min-height: 220px;
    padding: 1rem;
    position: relative;
  }

  .talisman-card.is-featured {
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-column: 1 / -1;
    grid-template-columns: minmax(320px, 0.72fr) minmax(0, 1.28fr);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .talisman-image {
    align-items: center;
    background: #ffff66;
    display: flex;
    height: 150px;
    justify-content: center;
    overflow: hidden;
    width: 88px;
  }

  .talisman-image img {
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .talisman-card.is-featured .talisman-image {
    height: 420px;
    padding: 1.25rem;
    width: 100%;
  }

  .is-featured .talisman-image img {
    max-height: none;
  }

  .talisman-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 160px;
    min-width: 0;
  }

  .talisman-card.is-featured .talisman-copy {
    min-height: 420px;
    padding: 2rem 2.75rem 2rem 1rem;
    position: relative;
  }

  .talisman-card:not(.is-featured) .talisman-copy {
    align-content: center;
    display: grid;
    gap: 0.5rem;
    grid-template-rows: 1.6em 1.7em;
    margin-inline: auto;
    width: 100%;
  }

  .talisman-heading {
    text-align: center;
  }

  .talisman-card:not(.is-featured) .talisman-heading {
    align-items: flex-end;
    display: flex;
    height: 1.6em;
    text-align: center;
  }

  .talisman-number {
    align-items: center;
    border: 1.5px solid var(--poster-red);
    border-radius: 50%;
    color: var(--poster-red);
    display: flex;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    font-weight: 700;
    height: 1.9rem;
    justify-content: center;
    line-height: 1;
    position: absolute;
    right: 0.85rem;
    top: 0.85rem;
    width: 1.9rem;
    z-index: 1;
  }

  .talisman-card h3 {
    color: #352d13;
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0;
    text-align: center;
  }

  .talisman-card:not(.is-featured) h3 {
    font-size: clamp(0.82rem, 1.3vw, 0.94rem);
    letter-spacing: 0;
    text-align: center;
    white-space: nowrap;
    width: 100%;
  }

  .talisman-card p {
    color: #6a5f31;
    font-size: 0.86rem;
    line-height: 1.7;
    margin: 0.55rem 0 0;
    min-height: 1.7em;
    text-align: center;
  }

  .talisman-card:not(.is-featured) .talisman-detail {
    font-size: 0.82rem;
    height: 1.7em;
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .talisman-card.is-featured h3 {
    color: var(--poster-red);
    font-size: clamp(1.75rem, 2.6vw, 2.1rem);
    text-align: left;
  }

  .talisman-card.is-featured .talisman-heading {
    padding-right: 3rem;
  }

  .talisman-card.is-featured p {
    min-height: 0;
    text-align: left;
  }

  .featured-number {
    right: 0;
    top: 0;
  }

  .talisman-card.is-featured .talisman-detail {
    color: #4f4828;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.9;
    margin-top: 1.3rem;
    padding-right: 1.5rem;
  }

  .featured-intro {
    color: #665c31 !important;
