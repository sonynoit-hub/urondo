---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import page from "../../content/classes-kitasenju-advanced";

const [
  scheduleSection,
  locationSection,
  feeSection,
  applicationSection,
  eligibilitySection,
  _contentSection,
  goalsSection,
  roleSection
] = page.sections ?? [];

const usesEmbeddedMarkers = (bullets?: string[]) =>
  Boolean(
    bullets?.length &&
      bullets.every((bullet) => /^(（.+?）|[①-⑳]|※)/.test(bullet.trim()))
  );

const overviewRows = [scheduleSection, locationSection, feeSection, applicationSection].filter(Boolean);
const deepCards = [goalsSection, roleSection].filter(Boolean);
const eligibilityItems =
  eligibilitySection?.bullets?.filter((bullet) => !bullet.trim().startsWith("※")) ?? [];
const eligibilityNote = eligibilitySection?.bullets?.find((bullet) => bullet.trim().startsWith("※"));
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  <section class="class-detail-hero-support class-detail-hero-support-kitasenju">
    <div class="container class-detail-hero-shell class-detail-hero-shell-kitasenju class-detail-hero-shell-single">
      <figure class="class-detail-hero-media class-detail-hero-media-banner class-detail-hero-media-plain">
        <img
          src="/images/source-extracted/classes-kitasenju-advanced/classes-kitasenju-advanced-01.jpeg"
          alt="心と体大元気365日の人体改造企画のバナー"
          width="920"
          height="257"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  {overviewRows.length > 0 && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>開催概要</h2>
        </div>

        <div class="class-detail-info-panel class-detail-info-panel-kitasenju">
          {overviewRows.map((section) => (
            <article class="class-detail-info-row">
              {section?.title && <h3>{section.title}</h3>}
              <div class="class-detail-prose">
                {section?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                {section?.bullets && (
                  <ul class:list={["class-detail-line-list", usesEmbeddedMarkers(section.bullets) && "class-detail-line-list-plain"]}>
                    {section.bullets.map((bullet) => <li data-note={bullet.trim().startsWith("※") ? "true" : undefined}>{bullet}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {eligibilitySection && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>{eligibilitySection.title}</h2>
        </div>

        <article class="class-detail-eligibility-card class-detail-eligibility-card-kitasenju">
          <div class="class-detail-prose">
            {eligibilitySection.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          {eligibilityItems.length > 0 && (
            <div class="class-detail-criteria-grid class-detail-criteria-grid-kitasenju">
              {eligibilityItems.map((bullet, index) => (
                <article class="class-detail-criteria-card">
                  <span class="class-detail-criteria-index">{String(index + 1).padStart(2, "0")}</span>
                  <p>{bullet}</p>
                </article>
              ))}
            </div>
          )}

          {eligibilityNote && (
            <p class="class-detail-criteria-note">{eligibilityNote}</p>
          )}
        </article>
      </div>
    </section>
  )}

  {deepCards.length > 0 && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="class-detail-meta-grid class-detail-meta-grid-kitasenju">
          {deepCards.map((section) => (
            <article class="class-detail-meta-card">
              {section?.title && <h3>{section.title}</h3>}
              <div class="class-detail-prose">
                {section?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                {section?.bullets && (
                  <ul class:list={["class-detail-line-list", usesEmbeddedMarkers(section.bullets) && "class-detail-line-list-plain"]}>
                    {section.bullets.map((bullet) => <li data-note={bullet.trim().startsWith("※") ? "true" : undefined}>{bullet}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

</MainLayout>
