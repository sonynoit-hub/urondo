---
import MainLayout from "../../layouts/MainLayout.astro";
import CTASection from "../../components/CTASection.astro";
import page from "../../content/classes";

const [teacherGreetingSection, teacherGoalsSection, teacherSupportSection] = page.sections ?? [];
---

<MainLayout title={page.title} description={page.description}>
  <section class="hero classes-hero">
    <div class="container classes-hero-inner">
      {page.heroIntro && <p class="hero-intro">{page.heroIntro}</p>}
      <h1>{page.heroTitle}</h1>
    </div>
  </section>

  {page.locations && page.locations.length > 0 && (
    <section class="content-section classes-locations-section">
      <div class="container">
        <div class="classes-location-grid">
          {page.locations.map((location) => (
            <article class="location-card location-preview-card classes-location-card">
              {location.href ? (
                <a class="classes-location-card-link" href={location.href}>
                  {location.image && (
                    <figure class="location-card-media">
                      <img
                        src={location.image}
                        alt={location.alt ?? location.name}
                        width="836"
                        height="469"
                        loading="lazy"
                      />
                    </figure>
                  )}

                  <div class="location-card-copy classes-location-name-only">
                    <h3>{location.name}</h3>
                  </div>
                </a>
              ) : (
                <>
                  {location.image && (
                    <figure class="location-card-media">
                      <img
                        src={location.image}
                        alt={location.alt ?? location.name}
                        width="836"
                        height="469"
                        loading="lazy"
                      />
                    </figure>
                  )}

                  <div class="location-card-copy classes-location-name-only">
                    <h3>{location.name}</h3>
                  </div>
                </>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {(teacherGreetingSection || teacherGoalsSection || teacherSupportSection) && (
    <section class="content-section classes-teacher-section">
      <div class="container">
        <div class="home-section-heading narrow-heading classes-teacher-heading">
          <h2>講師紹介</h2>
        </div>

        <div class="classes-teacher-card">
          {teacherGreetingSection && (
            <div class="classes-teacher-block">
              {teacherGreetingSection.title && <h3>{teacherGreetingSection.title}</h3>}
              {teacherGreetingSection.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          )}

          {teacherSupportSection && (
            <div class="classes-teacher-block classes-teacher-support">
              {teacherSupportSection.title && <h3>{teacherSupportSection.title}</h3>}
              {teacherSupportSection.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          )}

          {teacherGoalsSection && (
            <div class="classes-teacher-block classes-teacher-goals">
              {teacherGoalsSection.title && <h3>{teacherGoalsSection.title}</h3>}
              {teacherGoalsSection.bullets && (
                <ul>
                  {teacherGoalsSection.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {page.cards && page.cards.length > 0 && (
    <section class="content-section">
      <div class="container">
        <div class="home-section-heading narrow-heading">
          <h2>教室・講座一覧</h2>
        </div>

        <div class="classes-document-grid">
          {page.cards.map((card) => (
            card.href && (
              <a class="classes-document-button" href={card.href}>
                <span>{card.title}</span>
                {card.body && <small>{card.body}</small>}
              </a>
            )
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection class="about-final-cta" />
</MainLayout>
