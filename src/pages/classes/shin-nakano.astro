---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import page from "../../content/classes-shin-nakano";

const [
  introSection,
  syllabusSection,
  scheduleSection,
  teacherSection,
  feeSection,
  venueSection,
  applicationSection
] = page.sections ?? [];

const infoRows = [feeSection, venueSection, applicationSection].filter(Boolean);
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  {introSection && (
    <section class="content-section class-detail-section classroom-overview-section">
      <div class="container classroom-overview-grid">
        <figure class="classroom-overview-image">
          <img
            src="/images/source-extracted/access/shin-nakano.jpeg"
            alt="赤い床と掛け軸が並ぶ新中野教室の内観"
            width="588"
            height="441"
            loading="eager"
          />
          <figcaption class="classroom-overview-image-title">新中野教室</figcaption>
        </figure>

        <article class="class-detail-overview-card classroom-overview-copy">
          <div class="class-detail-prose">
            {introSection.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      </div>
    </section>
  )}

  {syllabusSection && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>{syllabusSection.title}</h2>
        </div>

        <div class="class-detail-syllabus-card">
          {syllabusSection.groups?.length ? (
            <div class="class-detail-syllabus-groups">
              {syllabusSection.groups.map((group) => (
                <section class="class-detail-syllabus-group">
                  <h3>{group.title}</h3>
                  <ul class="class-detail-syllabus-list">
                    {group.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : (
            <ul class="class-detail-syllabus-list">
              {syllabusSection.bullets?.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}

          {syllabusSection.paragraphs?.[0] && (
            <div class="class-detail-syllabus-note">
              <p>{syllabusSection.paragraphs[0]}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {infoRows.length > 0 && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>開催概要</h2>
        </div>

        <div class="classroom-mini-grid classroom-mini-grid-shin-nakano">
          <article class="classroom-mini-card classroom-mini-card-saturday">
            <h3>土曜日クラス</h3>
            <div class="class-detail-prose">
              {scheduleSection?.paragraphs?.[0] && <p>{scheduleSection.paragraphs[0]}</p>}
              {scheduleSection?.paragraphs?.[2] && (
                <div class="classroom-mini-note">
                  <p>{scheduleSection.paragraphs[2]}</p>
                </div>
              )}
            </div>

            <div class="classroom-mini-split">
              <h3>講師</h3>
              <div class="class-detail-prose">
                {teacherSection?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>

          <article class="classroom-mini-card classroom-mini-card-weekdays">
            <h3>水曜・金曜クラス</h3>
            <div class="class-detail-prose">
              {scheduleSection?.paragraphs?.[1] && <p>{scheduleSection.paragraphs[1]}</p>}
            </div>
          </article>
        </div>

        <div class="class-detail-info-panel">
          {infoRows.map((section) => (
            <article class="class-detail-info-row">
              {section?.title && <h3>{section.title}</h3>}
              <div class="class-detail-prose">
                {section?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>
