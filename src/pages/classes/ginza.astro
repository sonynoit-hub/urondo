---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHero from "../../components/PageHero.astro";
import page from "../../content/classes-ginza";

const [
  introSection,
  syllabusSection,
  thursdaySection,
  fridaySection,
  feeSection,
  venueSection,
  certificateSection,
  applicationSection
] = page.sections ?? [];

const scheduleCards = [
  thursdaySection && { label: "木曜日クラス", section: thursdaySection },
  fridaySection && { label: "金曜日クラス", section: fridaySection }
].filter(Boolean);

const sharedInfoRows = [feeSection, venueSection, certificateSection, applicationSection].filter(Boolean);
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  {introSection && (
    <section class="content-section class-detail-section classroom-overview-section">
      <div class="container classroom-overview-grid">
        <figure class="classroom-overview-image">
          <img
            src="/images/source-extracted/classes-overview/classes-overview-02.jpeg"
            alt="赤い座布団と仏像が並ぶ銀座教室の内観"
            width="836"
            height="469"
            loading="eager"
          />
          <figcaption class="classroom-overview-image-title">銀座教室</figcaption>
        </figure>

        <article class="class-detail-overview-card classroom-overview-copy">
          <div class="class-detail-prose">
            {introSection.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      </div>
    </section>
  )}

  {syllabusSection && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>{syllabusSection.title}</h2>
        </div>

        <div class="class-detail-syllabus-card">
          {syllabusSection.groups?.length ? (
            <div class="class-detail-syllabus-groups">
              {syllabusSection.groups.map((group) => (
                <section class="class-detail-syllabus-group">
                  <h3>{group.title}</h3>
                  <ul class="class-detail-syllabus-list">
                    {group.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : (
            <ul class="class-detail-syllabus-list">
              {syllabusSection.bullets?.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}

          {syllabusSection.paragraphs?.[0] && (
            <div class="class-detail-syllabus-note">
              <p>{syllabusSection.paragraphs[0]}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {scheduleCards.length > 0 && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>木曜日・金曜日クラス</h2>
          <p class="section-lead">銀座教室は曜日ごとに時間帯と担当講師が異なります。ご都合に合わせてお選びください。</p>
        </div>

        <div class="classroom-mini-grid">
          {scheduleCards.map((item) => (
            <article class="classroom-mini-card">
              <h3>{item?.label}</h3>
              <div class="class-detail-prose">
                {item?.section?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {sharedInfoRows.length > 0 && (
    <section class="content-section class-detail-section">
      <div class="container">
        <div class="home-section-heading narrow-heading class-detail-heading">
          <h2>開催概要</h2>
        </div>

        <div class="class-detail-info-panel">
          {sharedInfoRows.map((section) => (
            <article class="class-detail-info-row">
              {section?.title && <h3>{section.title}</h3>}
              <div class="class-detail-prose">
                {section?.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                {section?.bullets && (
                  <ul class="class-detail-line-list">
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>
