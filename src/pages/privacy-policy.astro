---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionBlock from "../components/SectionBlock.astro";
import page from "../content/privacy-policy";
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />
  <SectionBlock sections={page.sections} />
</MainLayout>
