---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import SectionBlock from "../components/SectionBlock.astro";
import DownloadBlock from "../components/DownloadBlock.astro";
import CTASection from "../components/CTASection.astro";
import page from "../content/contact";
---

<MainLayout title={page.title} description={page.description}>
  <Hero title={page.heroTitle} intro={page.heroIntro} />
  <SectionBlock sections={page.sections} />
  <DownloadBlock items={page.downloads} />
  <CTASection />
</MainLayout>
