---
import MainLayout from "../layouts/MainLayout.astro";
import page from "../content/contact";
import { site } from "../content/site";
---

<MainLayout title={page.title} description={page.description}>
  <section class="content-section contact-cta-section">
    <div class="container">
      <form
        class="qigong-app-form card contact-cta-form"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
      >
        <header class="contact-cta-head">
          <h1>お問い合わせ</h1>
        </header>

        <label class="qigong-app-field">
          <span>お名前（必須）</span>
          <input name="お名前" type="text" autocomplete="name" required />
        </label>

        <label class="qigong-app-field">
          <span>ご住所（必須）</span>
          <input name="ご住所" type="text" autocomplete="street-address" required />
        </label>

        <label class="qigong-app-field">
          <span>メールアドレス（必須）</span>
          <input name="メールアドレス" type="email" autocomplete="email" required />
        </label>

        <label class="qigong-app-field">
          <span>お電話番号（必須）</span>
          <input name="お電話番号" type="tel" autocomplete="tel" required />
        </label>

        <label class="qigong-app-field contact-cta-note-field">
          <span>お問い合わせ内容は以下の備考欄にご記入ください。</span>
          <textarea name="備考" rows="4" required></textarea>
        </label>

        <div class="contact-cta-actions">
          <button class="contact-cta-submit" type="submit">送信する</button>
        </div>
      </form>
    </div>
  </section>
</MainLayout>

<style>
  :global(body:has(.contact-cta-section) .page-shell) {
    min-height: auto;
  }

  :global(body:has(.contact-cta-section) .site-footer) {
    margin-top: 0;
  }

  .contact-cta-section {
    background: linear-gradient(145deg, rgba(24, 61, 53, 0.98), rgba(35, 79, 69, 0.97));
    padding-bottom: 1.1rem;
    padding-top: 1.1rem;
  }

  .contact-cta-section .container {
    display: flex;
    justify-content: center;
    min-height: auto;
  }

  .contact-cta-form {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(225, 213, 193, 0.95);
    box-shadow: 0 18px 34px rgba(20, 36, 31, 0.1);
    display: grid;
    flex: 1;
    gap: 0.5rem;
    max-width: 38rem;
    padding: 0.68rem 0.74rem 0.76rem;
    width: 100%;
  }

  .contact-cta-head {
    display: grid;
    gap: 0;
    padding-bottom: 0.45rem;
    text-align: center;
  }

  .contact-cta-head h1 {
    color: var(--accent);
    font-size: clamp(1.28rem, 1.85vw, 1.62rem);
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0;
  }

  .contact-cta-form .qigong-app-field {
    gap: 0.22rem;
  }

  .contact-cta-form .qigong-app-field span {
    color: var(--accent);
    font-size: 0.82rem;
  }

  .contact-cta-form .qigong-app-field input {
    min-height: 2.15rem;
    padding: 0.42rem 0.68rem;
  }

  .contact-cta-note-field {
    gap: 0.3rem;
  }

  .contact-cta-note-field textarea {
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(225, 213, 193, 0.95);
    border-radius: 16px;
    color: var(--text);
    font: inherit;
    line-height: 1.5;
    min-height: clamp(7rem, 16vh, 8.6rem);
    padding: 0.58rem 0.74rem 0.62rem;
    resize: vertical;
  }

  .contact-cta-note-field textarea:focus-visible {
    border-color: rgba(170, 134, 82, 0.8);
    outline: 3px solid rgba(170, 134, 82, 0.2);
    outline-offset: 1px;
  }

  .contact-cta-actions {
    display: flex;
    justify-content: center;
    padding-top: 0;
  }

  .contact-cta-submit {
    align-items: center;
    background: linear-gradient(135deg, rgba(24, 61, 53, 0.98), rgba(44, 90, 78, 0.96));
    border: 1px solid rgba(186, 154, 92, 0.42);
    border-radius: 999px;
    box-shadow: 0 12px 26px rgba(20, 36, 31, 0.14);
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-weight: 700;
    justify-content: center;
    min-height: 2.7rem;
    min-width: 9.4rem;
    padding: 0.56rem 1rem;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .contact-cta-submit:hover,
  .contact-cta-submit:focus-visible {
    border-color: rgba(186, 154, 92, 0.6);
    box-shadow: 0 16px 30px rgba(20, 36, 31, 0.18);
    transform: translateY(-1px);
  }

  @media (max-width: 720px) {
    .contact-cta-section {
      padding-bottom: 0.5rem;
      padding-top: 0.95rem;
    }

    .contact-cta-form {
      padding: 0.95rem;
      max-width: none;
    }

  }
</style>
