---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import page from "../content/news-page";
import { newsItems } from "../content/news";
---

<MainLayout title={page.title} description={page.description}>
  <PageHero title={page.heroTitle} subtitle={page.heroIntro ?? page.description} />

  <section class="content-section news-page-section">
    <div class="container">
      <div class="news-page-card">
        <div class="news-page-head">
          <h2>お知らせ一覧</h2>
        </div>

        <div class="news-page-list">
          {newsItems.map((item) => (
            item.href ? (
              <a class="news-page-row" href={item.href}>
                <time class="news-page-date" datetime={item.date.replaceAll("/", "-")}>{item.date}</time>
                <span class="news-page-title">{item.title}</span>
              </a>
            ) : (
              <div class="news-page-row">
                <time class="news-page-date" datetime={item.date.replaceAll("/", "-")}>{item.date}</time>
                <span class="news-page-title">{item.title}</span>
              </div>
            )
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .news-page-section {
    padding-top: 2.2rem;
  }

  .news-page-card {
    background: linear-gradient(180deg, rgba(255, 252, 246, 0.96), rgba(255, 255, 255, 0.94));
    border: 1px solid rgba(198, 171, 119, 0.28);
    border-radius: 2rem;
    box-shadow: 0 18px 40px rgba(36, 55, 49, 0.08);
    overflow: hidden;
  }

  .news-page-head {
    background: linear-gradient(135deg, rgba(24, 61, 53, 0.98), rgba(44, 90, 78, 0.96));
    color: #fff;
    padding: 1.6rem 1.9rem 1.4rem;
    text-align: center;
  }

  .news-page-head h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: 0.08em;
    margin: 0;
  }

  .news-page-list {
    display: grid;
  }

  .news-page-row {
    align-items: start;
    color: inherit;
    column-gap: 2rem;
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    padding: 1.5rem 1.9rem;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .news-page-row + .news-page-row {
    border-top: 1px solid rgba(198, 171, 119, 0.35);
  }

  a.news-page-row:hover,
  a.news-page-row:focus-visible {
    background: rgba(24, 61, 53, 0.05);
    color: var(--accent);
  }

  .news-page-date {
    color: #9c7432;
    font-feature-settings: "tnum";
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .news-page-title {
    color: var(--accent);
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    font-weight: 600;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .news-page-head,
    .news-page-row {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }

    .news-page-row {
      gap: 0.45rem;
      grid-template-columns: 1fr;
    }
  }
</style>
